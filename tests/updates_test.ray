// The update protocol between the page and the program: the manifest's place, the release as
// JSON both ways, and what the API makes of the page's requests. The network is not touched.

import std/fs;
import std/json;
import std/update;
import api;
import store;
import updates;

fn fresh() -> store.Store {
    let dir = fs.make_temp_dir("rayreq-updates").unwrap();
    store.open(dir + "/rayreq.db").unwrap()
}

fn sample() -> update.Release {
    update.Release {
        version: "0.2.0",
        notes: "https://github.com/ray-language/rayreq/releases/tag/v0.2.0",
        min_version: "",
        url: "https://github.com/ray-language/rayreq/releases/download/v0.2.0/RayReq-0.2.0-macos-aarch64.zip",
        sha256: "ab",
        size: 42
    }
}

@test
fn the_manifest_is_the_latest_github_release() {
    assert(updates.manifest_url()
        .starts_with("https://github.com/ray-language/rayreq/releases/latest/"));
    assert(updates.manifest_url().ends_with("/update.json"));
}

@test
fn a_release_survives_the_trip_through_json() {
    let r = sample();
    let text = json.stringify(updates.to_json(r));
    let back = updates.from_json(json.parse(text).unwrap()).unwrap();
    assert_eq(back.version, "0.2.0");
    assert_eq(back.url, r.url);
    assert_eq(back.notes, r.notes);
    assert_eq(back.sha256, "ab");
    assert_eq(back.size, 42);
}

@test
fn a_release_needs_a_web_url_and_its_digest() {
    let no_digest = json.parse("{\"version\":\"1.0.0\",\"url\":\"https://x/y.zip\",\"size\":1}")
        .unwrap();
    assert(updates.from_json(no_digest).is_err());
    let odd = json.parse("{\"version\":\"1.0.0\",\"url\":\"file:///etc\",\"sha256\":\"ab\",\"size\":1}")
        .unwrap();
    assert(updates.from_json(odd).is_err());
}

@test
fn the_page_asks_for_a_check_and_an_install() {
    let s = fresh();
    match (api.handle(s, "{\"op\":\"updates.check\"}")) {
        api.Action.CheckUpdate => { },
        _ => panic("expected a check"),
    }
    let body = "{\"op\":\"updates.install\",\"release\":"
        + json.stringify(updates.to_json(sample()))
        + "}";
    match (api.handle(s, body)) {
        api.Action.InstallUpdate(r) => assert_eq(r.version, "0.2.0"),
        _ => panic("expected an install"),
    }
    match (api.handle(s, "{\"op\":\"updates.install\",\"release\":{\"version\":\"1\"}}")) {
        api.Action.Reply(r) => assert(r.contains("missing field")),
        _ => panic("expected an error"),
    }
}

@test
fn a_skipped_version_is_a_setting_and_a_url_must_be_web() {
    let s = fresh();
    match (api.handle(s, "{\"op\":\"settings.set\",\"key\":\"skip_update\",\"value\":\"0.2.0\"}")) {
        api.Action.Reply(r) => assert(r.contains("true")),
        _ => panic("expected a reply"),
    }
    match (api.handle(s, "{\"op\":\"url.open\",\"url\":\"https://example.com\"}")) {
        api.Action.OpenUrl(u) => assert_eq(u, "https://example.com"),
        _ => panic("expected an open"),
    }
    match (api.handle(s, "{\"op\":\"url.open\",\"url\":\"file:///etc/passwd\"}")) {
        api.Action.Reply(r) => assert(r.contains("not a web URL")),
        _ => panic("expected an error"),
    }
}
