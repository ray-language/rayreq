// JSON paths over the body's text: values come back as written (R6 of docs/VARIABLES.md).

import jpath;

fn at(body: string, path: string) -> string {
    match (jpath.value_at(body, jpath.parse_path(path).unwrap())) {
        Result.Ok(v) => v,
        Result.Err(jpath.Miss.Invalid) => "<invalid>",
        Result.Err(jpath.Miss.NotFound) => "<not found>",
    }
}

// Backtick strings process escapes too: `\\"` is a backslash and a quote in the JSON.
const DOC: string = `{
  "data": {
    "id": 12345678901234567890,
    "price": 1.10,
    "big": 1e400,
    "name": "Ana \\"A\\" \\u00f1",
    "none": null,
    "on": true,
    "tags": [ "a", "b" ],
    "nested": { "k" : [ 1, { "z": "y y" } ] },
    "a.b": "dotted",
    "empty": {}
  },
  "items": [ { "id": 1 }, { "id": 2 } ]
}`;

@test
fn numbers_keep_their_text() {
    assert_eq(at(DOC, "data.id"), "12345678901234567890");
    assert_eq(at(DOC, "data.price"), "1.10");
    assert_eq(at(DOC, "$.data.big"), "1e400");
}

@test
fn strings_null_and_booleans() {
    assert_eq(at(DOC, "data.name"), "Ana \"A\" ñ");
    assert_eq(at(DOC, "data.none"), "");
    assert_eq(at(DOC, "data.on"), "true");
}

@test
fn objects_and_arrays_come_back_compact() {
    assert_eq(at(DOC, "data.tags"), "[\"a\",\"b\"]");
    assert_eq(at(DOC, "data.nested"), "{\"k\":[1,{\"z\":\"y y\"}]}");
    assert_eq(at(DOC, "data.empty"), "{}");
}

@test
fn indexes_and_quoted_keys() {
    assert_eq(at(DOC, "items[1].id"), "2");
    assert_eq(at(DOC, "$.items[0].id"), "1");
    assert_eq(at(DOC, "data[\"a.b\"]"), "dotted");
    assert_eq(at(DOC, "data.nested.k[1].z"), "y y");
    assert_eq(at("[10, 20]", "$[1]"), "20");
}

@test
fn misses_are_told_apart() {
    assert_eq(at(DOC, "items[2]"), "<not found>");
    assert_eq(at(DOC, "data.id.deeper"), "<not found>");
    assert_eq(at(DOC, "data.tags.x"), "<not found>");
    assert_eq(at(DOC, "data[0]"), "<not found>");
    assert_eq(at(DOC, "nope"), "<not found>");
    assert_eq(at("{\"a\": ", "a"), "<invalid>");
    assert_eq(at("[]", "[0]"), "<not found>");
}

@test
fn bad_paths_are_errors() {
    assert(jpath.parse_path("").is_err());
    assert(jpath.parse_path("$").is_err());
    assert(jpath.parse_path("a..b").is_err());
    assert(jpath.parse_path("a[x]").is_err());
    assert(jpath.parse_path("a[-1]").is_err());
    assert(jpath.parse_path("a[1").is_err());
}
