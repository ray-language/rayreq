//! URLs as a REST client needs them: what the user typed, split by `std/url` and
//! percent-encoded without double-encoding what is already encoded, and a redirect's
//! `Location` resolved against the URL that answered.

import std/url;

pub struct Url {
    scheme: string,
    /// Without brackets for IPv6 (`::1`); `authority` puts them back.
    host: string,
    /// 0 = the scheme's default.
    port: int,
    /// Starts with `/` (an empty path is `/`).
    path: string,
    /// Without the `?`; empty = none.
    query: string,
}

pub fn default_port(scheme: string) -> int {
    if (scheme == "https") { 443 } else { 80 }
}

pub fn effective_port(u: Url) -> int {
    if (u.port == 0) { default_port(u.scheme) } else { u.port }
}

/// `host[:port]` as the Host header and the URL write it.
pub fn authority(u: Url) -> string {
    let h = if (u.host.contains(":")) { "[${u.host}]" } else { u.host };
    if (u.port == 0 || u.port == default_port(u.scheme)) { h } else { "${h}:${u.port}" }
}

/// `scheme://host:port`: two URLs with the same origin may share credentials.
pub fn origin(u: Url) -> string {
    "${u.scheme}://${u.host}:${effective_port(u)}"
}

/// The request target of the request line: path and query.
pub fn target(u: Url) -> string {
    if (u.query == "") { u.path } else { "${u.path}?${u.query}" }
}

pub fn render(u: Url) -> string {
    "${u.scheme}://${authority(u)}${target(u)}"
}

/// What the user typed, with `http://` in front when there is no scheme (`localhost:8080/x`,
/// `api.example.com`), as curl and browsers do.
pub fn with_scheme(raw: string) -> string {
    let s = raw.trim();
    let lower = s.to_lower();
    if (lower.starts_with("http://") || lower.starts_with("https://")) {
        return s;
    }
    match (s.index_of("://")) {
        Option.Some(_) => s,
        Option.None => "http://" + s,
    }
}

fn is_hex(c: char) -> bool {
    let n = char_code(c);
    (n >= 48 && n <= 57) || (n >= 65 && n <= 70) || (n >= 97 && n <= 102)
}

/// Characters that may appear as they are in a path or query (RFC 3986 unreserved,
/// sub-delims, `:`, `@`, `/`, `?`). `%` is handled apart; `#` never reaches here.
fn is_url_char(c: char) -> bool {
    let n = char_code(c);
    if ((n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)) {
        return true;
    }
    "-._~!$&'()*+,;=:@/?".contains(c.to_string())
}

/// Percent-encodes what cannot travel as it is (spaces, quotes, `{}`, `|`, non-ASCII…) and
/// leaves valid `%XX` escapes alone, so normalizing twice changes nothing. A `%` that does not
/// start an escape becomes `%25`.
pub fn encode_loose(s: string) -> string {
    let cs = s.chars();
    var out = "";
    var i = 0;
    while (i < cs.len()) {
        let c = cs[i];
        if (c == '%') {
            if (i + 2 < cs.len() && is_hex(cs[i + 1]) && is_hex(cs[i + 2])) {
                out = out + "%";
            } else {
                out = out + "%25";
            }
        } else if (is_url_char(c)) {
            out = out + c.to_string();
        } else {
            out = out + url.url_encode(c.to_string());
        }
        i = i + 1;
    }
    out
}

/// A registered name or IPv4 address: letters, digits, '-', '.', '_' (and non-ASCII letters of
/// an internationalized name). Anything else (`{{base}}`, spaces) cannot reach a server.
fn valid_host(host: string) -> bool {
    for c in host.chars() {
        let n = char_code(c);
        // 0-9, A-Z, a-z, '-', '.', '_', non-ASCII
        let ok = (n >= 48 && n <= 57)
            || (n >= 65 && n <= 90)
            || (n >= 97 && n <= 122)
            || n == 45
            || n == 46
            || n == 95
            || n > 127;
        if (!ok) {
            return false;
        }
    }
    true
}

/// Spaces and control characters percent-encoded: what `std/url` refuses but a user may type
/// (`/search?q=a b`).
fn escape_blanks(s: string) -> string {
    var parts: [string] = [];
    for c in s.chars() {
        let n = char_code(c);
        parts.push(
            if (n <= 32 || n == 127) { url.url_encode(c.to_string()) } else { c.to_string() }
        );
    }
    join(parts, "")
}

/// Splits an absolute `http`/`https` URL. The fragment is dropped (it never goes on the wire).
pub fn parse(raw: string) -> Result<Url, string> {
    let s = raw.trim();
    if (s.index_of("://").is_none()) {
        return Result.Err("not an absolute URL: '${s}'");
    }
    let u = url.parse(escape_blanks(s))?;
    let scheme = u.scheme.to_lower();
    if (scheme != "http" && scheme != "https") {
        return Result.Err("unsupported scheme '${scheme}' (only http and https)");
    }
    // userinfo@ is not supported: say so instead of dropping it.
    if (u.userinfo.is_some()) {
        return Result.Err("credentials in the URL are not supported; use an Authorization header");
    }
    let host = u.host.unwrap_or("");
    if (host == "") {
        return Result.Err("missing host in '${s}'");
    }
    if (!host.contains(":") && !valid_host(host)) {
        return Result.Err("invalid host '${host}'");
    }
    let port = u.port.unwrap_or(0);
    if (u.port == Option.Some(0)) {
        return Result.Err("port out of range: 0");
    }
    Result.Ok(
        Url {
            scheme: scheme,
            host: host.to_lower(),
            port: port,
            path: encode_loose(if (u.path == "") { "/" } else { u.path }),
            query: encode_loose(u.query.unwrap_or(""))
        }
    )
}

/// The absolute URL a `Location` header points to, relative to the URL that answered.
pub fn resolve(base: Url, location: string) -> Result<Url, string> {
    let loc = location.trim().split("#")[0];
    if (loc == "") {
        return Result.Ok(base);
    }
    parse(url.resolve(render(base), escape_blanks(loc))?)
}

/// `application/x-www-form-urlencoded`: spaces as `+`, the rest per RFC 3986.
pub fn form_encode(pairs: [(string, string)]) -> string {
    var parts: [string] = [];
    for (k, v) in pairs {
        parts.push(form_component(k) + "=" + form_component(v));
    }
    join(parts, "&")
}

fn form_component(s: string) -> string {
    url.url_encode(s).replace("%20", "+")
}
