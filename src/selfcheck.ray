//! `--check`: the app on a scratch database, with a local echo server for the page's scripted
//! run (www/check.js). The page reports with `window.ray.send("check:ok")` or
//! `"check:fail:<why>"`; a watchdog ends the run if it never does.

import std/fs;
import std/json;
import std/net;
import std/time;
import std/url;
import net/webserver;
import oauth;

const WATCHDOG_MS: int = 30000;

/// `a=1&b=x%20y` as a map, decoded.
fn query_map(q: string) -> Map<string, string> {
    let m: Map<string, string> = Map.new();
    for part in q.split("&") {
        let kv = part.split("=");
        if (kv.len() == 2) {
            m.insert(
                url.url_decode(kv[0]).unwrap_or(kv[0]),
                url.url_decode(kv[1].replace("+", " ")).unwrap_or(kv[1])
            );
        }
    }
    m
}

fn echo(req: webserver.Request) -> webserver.Response {
    if (req.path == "/redirect") {
        var r = webserver.text(302, "");
        r.headers.insert("Location", "/echo?from=redirect");
        return r;
    }
    if (req.path == "/login") {
        var r = webserver.text(302, "");
        r.headers.insert("Location", "/echo?from=login");
        r.set_cookie.push("sid=abc; Path=/; HttpOnly");
        return r;
    }
    if (req.path == "/oauth/authorize") {
        // Approves at once: back to the app's loopback address with a code that carries the
        // PKCE challenge (so the token endpoint can check the verifier without state).
        let q = query_map(req.query);
        let back = q.get_or("redirect_uri", "");
        var r = webserver.text(302, "");
        r.headers.insert(
            "Location",
            "${back}?code=code-${q.get_or("code_challenge", "")}&state=${url.url_encode(q.get_or("state", ""))}"
        );
        return r;
    }
    if (req.path == "/oauth/token") {
        let f = query_map(from_utf8(req.body).unwrap_or(""));
        let grant = f.get_or("grant_type", "");
        let access = if (grant == "client_credentials") {
            "cc-token"
        } else if (grant == "authorization_code"
            && f.get_or("code", "") == "code-" + oauth.challenge(f.get_or("code_verifier", ""))) {
            "ac-token"
        } else {
            ""
        };
        if (access == "") {
            var r = webserver.json_response("{\"error\":\"invalid_grant\"}");
            r.status = 400;
            return r;
        }
        return webserver.json_response(
            "{\"access_token\":\"${access}\",\"token_type\":\"Bearer\",\"expires_in\":3600}"
        );
    }
    if (req.path == "/raw") {
        // The body as it came, with its Content-Type first (multipart checks read it).
        let ct = req.headers.get_or("content-type", "");
        return webserver.text(200, ct + "\n\n" + from_utf8(req.body).unwrap_or("<binary>"));
    }
    if (req.path == "/page") {
        // A page whose lines are long: wrapped, it is much taller than the pane.
        var long = "";
        for i in 0..400 {
            long = long + "<span class=\"c${i}\">word ${i}</span>";
        }
        var r = webserver.text(
            200,
            "<!DOCTYPE html>\n<html>\n  <body>\n    ${long}\n    ${long}\n  </body>\n</html>\n"
        );
        r.headers.insert("Content-Type", "text/html; charset=utf-8");
        return r;
    }
    if (req.path == "/missing") {
        return webserver.text(404, "no such thing");
    }
    if (req.path == "/slow") {
        time.sleep(5000);
        return webserver.text(200, "late");
    }
    // The credentials it got, as JSON strings (quotes escaped).
    let auth = json.stringify(json.Json.JStr(req.headers.get_or("authorization", "")));
    let key = json.stringify(json.Json.JStr(req.headers.get_or("x-api-key", "")));
    let cookie = json.stringify(json.Json.JStr(req.headers.get_or("cookie", "")));
    let body = "{\"method\":\"${req.method}\",\"path\":\"${req.raw_path}\",\"query\":\"${req.query}\",\"size\":${req.body.len()},\"big\":12345678901234567890,\"auth\":${auth},\"key\":${key},\"cookie\":${cookie}}";
    var r = webserver.json_response(body);
    r.headers.insert("X-Echo", "1");
    r
}

/// Starts the echo server on a free port (port 0) and the watchdog; returns the port.
pub fn start_server() -> Result<int, string> {
    let l = net.tcp_listen("127.0.0.1", 0)?;
    let port = net.local_port(l);
    let _server = spawn(fn() {
        let _ = webserver.serve_options_on(
            l,
            webserver.options().quiet(),
            fn() -> fn(webserver.Request) -> webserver.Response { echo }
        );
    });
    let _watchdog = spawn(fn() {
        time.sleep(WATCHDOG_MS);
        eprint("rayreq: check failed: the page did not report in ${WATCHDOG_MS / 1000} s");
        exit(1);
    });
    Result.Ok(port)
}

/// A small file for the multipart check to upload, as the page's `&file=<path>` parameter.
pub fn sample_query() -> Result<string, string> {
    let dir = fs.make_temp_dir("rayreq-check-file")?;
    let path = dir + "/sample.txt";
    fs.write_file(path, "sample ñ\n")?;
    Result.Ok("&file=" + url.url_encode(path))
}

/// The exit code a page message stands for, or None when it is not a verdict.
pub fn verdict(tag: string) -> Option<int> {
    if (tag == "check:ok") {
        print("rayreq: check ok");
        return Option.Some(0);
    }
    if (tag.starts_with("check:fail:")) {
        eprint("rayreq: check failed: " + tag.substring(11, tag.len()));
        return Option.Some(1);
    }
    Option.None
}
