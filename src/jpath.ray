//! A value inside a JSON body, as written. `json.Json` keeps numbers as floats, so a 64-bit id
//! would come back rounded (12345678901234567890 → 1.2345678901234567e19): the path is walked
//! over a `json.Doc`, which keeps each number's text (R6 of docs/VARIABLES.md).
//!
//! Paths: `data.items[0].id`, optionally starting with `$` (`$.data`, `$[0]`); a key with dots
//! or brackets goes quoted: `headers["content-type"]`. A repeated key: the first one counts.

import std/json;

pub enum Seg {
    Key(string),
    Index(int),
}

pub enum Miss {
    /// The body is not valid JSON.
    Invalid,
    /// The path does not name a value of this body.
    NotFound,
}

/// `path` split into keys and indexes.
pub fn parse_path(path: string) -> Result<[Seg], string> {
    var p = path.trim();
    if (p.starts_with("$")) {
        p = p.substring(1, p.len());
    }
    var out: [Seg] = [];
    var key = "";
    var i = 0;
    let cs = p.chars();
    while (i < cs.len()) {
        let c = cs[i].to_string();
        if (c == ".") {
            if (key != "") {
                out.push(Seg.Key(key));
                key = "";
            } else if (i > 0 && cs[i - 1].to_string() != "]") {
                return Result.Err("empty key in path '${path}'");
            }
            i = i + 1;
        } else if (c == "[") {
            if (key != "") {
                out.push(Seg.Key(key));
                key = "";
            }
            var j = i + 1;
            while (j < cs.len() && cs[j].to_string() != "]") {
                j = j + 1;
            }
            if (j >= cs.len()) {
                return Result.Err("missing ']' in path '${path}'");
            }
            let inner = p.substring(i + 1, j).trim();
            if (inner.starts_with("\"")) {
                match (json.parse(inner)) {
                    Result.Ok(v) => match (json.as_string(v)) {
                        Option.Some(k) => out.push(Seg.Key(k)),
                        Option.None => return Result.Err("bad key ${inner} in path '${path}'"),
                    },
                    Result.Err(_) => return Result.Err("bad key ${inner} in path '${path}'"),
                }
            } else {
                match (parse_int(inner)) {
                    Option.Some(n) => if (n < 0) {
                        return Result.Err("negative index in path '${path}'");
                    } else {
                        out.push(Seg.Index(n));
                    },
                    Option.None => return Result.Err("bad index [${inner}] in path '${path}'"),
                }
            }
            i = j + 1;
        } else {
            key = key + c;
            i = i + 1;
        }
    }
    if (key != "") {
        out.push(Seg.Key(key));
    }
    if (out.len() == 0) {
        return Result.Err("the path is empty");
    }
    Result.Ok(out)
}

/// The first member `key` of an object (`json.doc_get` gives the last).
fn member(d: json.Doc, key: string) -> Option<json.Doc> {
    match (d) {
        json.Doc.Obj(_) => {
            for m in json.doc_members(d) {
                if (m.key == key) {
                    return Option.Some(m.value);
                }
            }
            Option.None
        },
        _ => Option.None,
    }
}

/// The compact JSON text of the value at `path` in `body`.
pub fn raw_at(body: string, path: [Seg]) -> Result<string, Miss> {
    var d = match (json.parse_doc(body)) {
        Result.Ok(d) => d,
        Result.Err(_) => return Result.Err(Miss.Invalid),
    };
    for seg in path {
        let next = match (seg) {
            Seg.Key(key) => member(d, key),
            Seg.Index(n) => json.doc_at(d, n),
        };
        d = match (next) {
            Option.Some(v) => v,
            Option.None => return Result.Err(Miss.NotFound),
        };
    }
    Result.Ok(json.render_doc(d))
}

/// The value at `path` as a variable holds it: a string unquoted (escapes decoded), `null` as
/// "", a number or boolean as written, an object or array as compact JSON.
pub fn value_at(body: string, path: [Seg]) -> Result<string, Miss> {
    let raw = raw_at(body, path)?;
    if (raw.starts_with("\"")) {
        return match (json.parse(raw)) {
            Result.Ok(v) => Result.Ok(json.as_string(v).unwrap_or("")),
            Result.Err(_) => Result.Err(Miss.Invalid),
        };
    }
    if (raw == "null") {
        return Result.Ok("");
    }
    Result.Ok(raw)
}
