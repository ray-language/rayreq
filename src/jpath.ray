//! A value inside a JSON body, read from its TEXT. std/json parses numbers into floats, so a
//! 64-bit id would come back rounded (12345678901234567890 → 1.2345678901234567e19): here the
//! path is walked over the bytes and the value is returned as written (R6 of
//! docs/VARIABLES.md).
//!
//! Paths: `data.items[0].id`, optionally starting with `$` (`$.data`, `$[0]`); a key with dots
//! or brackets goes quoted: `headers["content-type"]`. A repeated key: the first one counts.

import std/json;

pub enum Seg {
    Key(string),
    Index(int),
}

pub enum Miss {
    /// The body is not valid JSON.
    Invalid,
    /// The path does not name a value of this body.
    NotFound,
}

/// `path` split into keys and indexes.
pub fn parse_path(path: string) -> Result<[Seg], string> {
    var p = path.trim();
    if (p.starts_with("$")) {
        p = p.substring(1, p.len());
    }
    var out: [Seg] = [];
    var key = "";
    var i = 0;
    let cs = p.chars();
    while (i < cs.len()) {
        let c = cs[i].to_string();
        if (c == ".") {
            if (key != "") {
                out.push(Seg.Key(key));
                key = "";
            } else if (i > 0 && cs[i - 1].to_string() != "]") {
                return Result.Err("empty key in path '${path}'");
            }
            i = i + 1;
        } else if (c == "[") {
            if (key != "") {
                out.push(Seg.Key(key));
                key = "";
            }
            var j = i + 1;
            while (j < cs.len() && cs[j].to_string() != "]") {
                j = j + 1;
            }
            if (j >= cs.len()) {
                return Result.Err("missing ']' in path '${path}'");
            }
            let inner = p.substring(i + 1, j).trim();
            if (inner.starts_with("\"")) {
                match (json.parse(inner)) {
                    Result.Ok(v) => match (json.as_string(v)) {
                        Option.Some(k) => out.push(Seg.Key(k)),
                        Option.None => return Result.Err("bad key ${inner} in path '${path}'"),
                    },
                    Result.Err(_) => return Result.Err("bad key ${inner} in path '${path}'"),
                }
            } else {
                match (parse_int(inner)) {
                    Option.Some(n) => if (n < 0) {
                        return Result.Err("negative index in path '${path}'");
                    } else {
                        out.push(Seg.Index(n));
                    },
                    Option.None => return Result.Err("bad index [${inner}] in path '${path}'"),
                }
            }
            i = j + 1;
        } else {
            key = key + c;
            i = i + 1;
        }
    }
    if (key != "") {
        out.push(Seg.Key(key));
    }
    if (out.len() == 0) {
        return Result.Err("the path is empty");
    }
    Result.Ok(out)
}

// Byte codes of the JSON punctuation.
const QUOTE: int = 34;

const BACKSLASH: int = 92;

const LBRACE: int = 123;

const RBRACE: int = 125;

const LBRACKET: int = 91;

const RBRACKET: int = 93;

const COMMA: int = 44;

const COLON: int = 58;

fn is_space(c: int) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

fn skip_ws(b: bytes, i: int) -> int {
    var k = i;
    while (k < b.len() && is_space(b[k])) {
        k = k + 1;
    }
    k
}

/// `i` at an opening quote → just past the closing one.
fn skip_string(b: bytes, i: int) -> int {
    var k = i + 1;
    while (k < b.len()) {
        let c = b[k];
        if (c == BACKSLASH) {
            k = k + 2;
        } else if (c == QUOTE) {
            return k + 1;
        } else {
            k = k + 1;
        }
    }
    k
}

/// `i` at the start of a value → just past its end. The text is known to be valid JSON.
fn skip_value(b: bytes, i: int) -> int {
    let c = b[i];
    if (c == QUOTE) {
        return skip_string(b, i);
    }
    if (c == LBRACE || c == LBRACKET) {
        var depth = 0;
        var k = i;
        while (k < b.len()) {
            let d = b[k];
            if (d == QUOTE) {
                k = skip_string(b, k);
                continue;
            }
            if (d == LBRACE || d == LBRACKET) {
                depth = depth + 1;
            } else if (d == RBRACE || d == RBRACKET) {
                depth = depth - 1;
                if (depth == 0) {
                    return k + 1;
                }
            }
            k = k + 1;
        }
        return k;
    }
    // A number, true, false or null.
    var k = i;
    while (k < b.len() && !is_space(b[k]) && b[k] != COMMA && b[k] != RBRACE && b[k] != RBRACKET) {
        k = k + 1;
    }
    k
}

fn text_of(b: bytes, from: int, to: int) -> string {
    from_utf8(b.sub_bytes(from, to)).unwrap_or("")
}

/// The start of member `key` of the object at `i`, or None.
fn member_at(b: bytes, i: int, key: string) -> Option<int> {
    var k = skip_ws(b, i + 1);
    while (k < b.len() && b[k] == QUOTE) {
        let end = skip_string(b, k);
        let name = match (json.parse(text_of(b, k, end))) {
            Result.Ok(v) => json.as_string(v).unwrap_or(""),
            Result.Err(_) => "",
        };
        k = skip_ws(b, end);  // at ':'
        k = skip_ws(b, k + 1);
        if (name == key) {
            return Option.Some(k);
        }
        k = skip_ws(b, skip_value(b, k));
        if (k < b.len() && b[k] == COMMA) {
            k = skip_ws(b, k + 1);
        } else {
            break;
        }
    }
    Option.None
}

/// The start of item `n` of the array at `i`, or None.
fn item_at(b: bytes, i: int, n: int) -> Option<int> {
    var k = skip_ws(b, i + 1);
    if (k < b.len() && b[k] == RBRACKET) {
        return Option.None;
    }
    var idx = 0;
    while (k < b.len()) {
        if (idx == n) {
            return Option.Some(k);
        }
        k = skip_ws(b, skip_value(b, k));
        if (k < b.len() && b[k] == COMMA) {
            k = skip_ws(b, k + 1);
            idx = idx + 1;
        } else {
            break;
        }
    }
    Option.None
}

/// The JSON text of a value without the whitespace between its tokens.
pub fn compact(text: string) -> string {
    let b = text.to_bytes();
    var k = 0;
    var start = 0;
    var parts: [string] = [];
    while (k < b.len()) {
        let c = b[k];
        if (c == QUOTE) {
            k = skip_string(b, k);
        } else if (is_space(c)) {
            parts.push(text_of(b, start, k));
            k = skip_ws(b, k);
            start = k;
        } else {
            k = k + 1;
        }
    }
    parts.push(text_of(b, start, b.len()));
    parts.join("")
}

/// The raw JSON text of the value at `path` in `body`.
pub fn raw_at(body: string, path: [Seg]) -> Result<string, Miss> {
    if (json.parse(body).is_err()) {
        return Result.Err(Miss.Invalid);
    }
    let b = body.to_bytes();
    var k = skip_ws(b, 0);
    for seg in path {
        let next = match (seg) {
            Seg.Key(key) => if (b[k] == LBRACE) { member_at(b, k, key) } else { Option.None },
            Seg.Index(n) => if (b[k] == LBRACKET) { item_at(b, k, n) } else { Option.None },
        };
        k = match (next) {
            Option.Some(at) => at,
            Option.None => return Result.Err(Miss.NotFound),
        };
    }
    Result.Ok(text_of(b, k, skip_value(b, k)))
}

/// The value at `path` as a variable holds it: a string unquoted (escapes decoded), `null` as
/// "", a number or boolean as written, an object or array as compact JSON.
pub fn value_at(body: string, path: [Seg]) -> Result<string, Miss> {
    let raw = raw_at(body, path)?;
    if (raw.starts_with("\"")) {
        return match (json.parse(raw)) {
            Result.Ok(v) => Result.Ok(json.as_string(v).unwrap_or("")),
            Result.Err(_) => Result.Err(Miss.Invalid),
        };
    }
    if (raw == "null") {
        return Result.Ok("");
    }
    if (raw.starts_with("{") || raw.starts_with("[")) {
        return Result.Ok(compact(raw));
    }
    Result.Ok(raw)
}
