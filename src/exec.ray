//! Sends a request: from the stored (or draft) `model.Request` to what goes on the wire
//! (`prepare`), then the exchange itself with redirects and the timeout (`run`).
//!
//! `run` blocks its fiber for the whole exchange: the program calls it from a fiber of its own
//! per send, so the window keeps answering.

import std/time;
import net/http;
import cookies;
import model;
import multipart;
import urls;

pub const USER_AGENT: string = "rayreq/0.1.1";

/// A request ready to go: the URL parsed and encoded, the enabled headers (plus the defaults)
/// and the body as bytes.
pub struct Prepared {
    method: string,
    url: urls.Url,
    headers: [(string, string)],
    body: bytes,
    timeout_ms: int,
    follow_redirects: bool,
    max_redirects: int,
    /// Header names (lower case) that carry credentials besides the standard ones (an API key
    /// header from the auth): they do not follow a redirect to another origin either.
    credentials: [string],
    /// The cookie jar of the send (a copy; updated hop by hop), when the request uses it.
    use_jar: bool,
    jar: [cookies.Cookie],
}

/// A redirect that was followed: who answered it and with what.
pub struct Hop {
    status: int,
    method: string,
    url: string,
    location: string,
}

/// What was actually sent in the last exchange (after redirects), headers the HTTP client adds
/// on its own included, for the "raw request" view.
pub struct Sent {
    method: string,
    url: string,
    headers: [(string, string)],
    body: bytes,
}

pub struct Outcome {
    ok: bool,
    /// Why there is no response (connect failure, timeout, too many redirects…); "" when ok.
    error: string,
    status: int,
    /// Names in lower case, in the order received; repeated names (Set-Cookie) kept.
    headers: [(string, string)],
    /// Decoded: a gzip body arrives already inflated (net/http does it).
    body: bytes,
    duration_ms: int,
    /// Wall clock of the start, ms since the epoch.
    started_at: int,
    sent: Sent,
    hops: [Hop],
    /// Every Set-Cookie received with the URL that sent it, in order, redirects included (for
    /// the stored jar); empty when the request does not use the jar.
    set_cookies: [(string, string)],
}

// ---- prepare -------------------------------------------------------------------------------

fn lower_names(hs: [(string, string)]) -> [string] {
    var out: [string] = [];
    for (k, _v) in hs {
        out.push(k.to_lower());
    }
    out
}

/// A header name is an RFC 9110 token: no spaces, no separators, no control characters.
fn valid_header_name(name: string) -> bool {
    if (name == "") {
        return false;
    }
    for c in name.chars() {
        let n = char_code(c);
        if (n <= 32 || n >= 127 || "()<>@,;:\\\"/[]?={}".contains(c.to_string())) {
            return false;
        }
    }
    true
}

fn content_type_of(body_type: string) -> string {
    match (body_type) {
        "json" => "application/json",
        "xml" => "application/xml",
        "text" => "text/plain; charset=utf-8",
        "form" => "application/x-www-form-urlencoded",
        "multipart" => "multipart/form-data",
        _ => "",
    }
}

/// A multipart body and the headers that announce it. A Content-Type written by hand keeps its
/// boundary when it names one, and gets ours added when it does not.
fn with_multipart(
    headers: [(string, string)],
    parts: [model.Part]
) -> Result<([(string, string)], bytes), string> {
    var given: Option<string> = Option.None;
    var at = -1;
    var i = 0;
    while (i < headers.len()) {
        if (headers[i].0.to_lower() == "content-type") {
            at = i;
            given = multipart.boundary_of(headers[i].1);
        }
        i = i + 1;
    }
    var tries = 0;
    while (true) {
        let boundary = match (given) {
            Option.Some(b) => b,
            Option.None => multipart.new_boundary(),
        };
        match (multipart.encode(parts, boundary)) {
            Result.Ok(body) => {
                var out = [] + headers;
                if (at < 0) {
                    out.push(("Content-Type", multipart.content_type(boundary)));
                } else if (given.is_none()) {
                    out[at] = (headers[at].0, headers[at].1 + "; boundary=" + boundary);
                }
                return Result.Ok((out, body));
            },
            Result.Err(e) => {
                tries = tries + 1;
                if (e != "boundary collision" || given.is_some() || tries > 5) {
                    return Result.Err(
                        if (e == "boundary collision") {
                            "a part contains the boundary of the Content-Type header"
                        } else {
                            e
                        }
                    );
                }
            },
        }
    }
}

/// The enabled rows only, trimmed; a header with an invalid name or a line break in its value
/// is an error (a value with CR/LF would inject headers of its own).
pub fn prepare(r: model.Request) -> Result<Prepared, string> {
    if (r.url == "") {
        return Result.Err("the URL is empty");
    }
    let u = urls.parse(urls.with_scheme(r.url))?;
    var headers: [(string, string)] = [];
    for h in r.headers {
        if (!h.enabled) {
            continue;
        }
        let name = h.key.trim();
        if (name == "" && h.value.trim() == "") {
            continue;
        }
        if (!valid_header_name(name)) {
            return Result.Err("invalid header name: '${name}'");
        }
        if (h.value.contains("\r") || h.value.contains("\n")) {
            return Result.Err("the value of header '${name}' contains a line break");
        }
        headers.push((name, h.value.trim()));
    }
    var body = match (r.body_type) {
        "none" => b"",
        "form" => {
            var fields: [(string, string)] = [];
            for f in r.form {
                if (f.enabled && f.key != "") {
                    fields.push((f.key, f.value));
                }
            }
            urls.form_encode(fields).to_bytes()
        },
        "multipart" => b"",
        _ => r.body.to_bytes(),
    };
    if (r.body_type == "multipart") {
        let (h, b) = with_multipart(headers, r.parts)?;
        headers = h;
        body = b;
    }
    let names = lower_names(headers);
    let ctype = content_type_of(r.body_type);
    if (ctype != "" && !names.contains("content-type")) {
        headers.push(("Content-Type", ctype));
    }
    if (!names.contains("accept")) {
        headers.push(("Accept", "*/*"));
    }
    if (!names.contains("user-agent")) {
        headers.push(("User-Agent", USER_AGENT));
    }
    Result.Ok(
        Prepared {
            method: r.method,
            url: u,
            headers: headers,
            body: body,
            timeout_ms: r.timeout_ms,
            follow_redirects: r.follow_redirects,
            max_redirects: r.max_redirects,
            credentials: [],
            use_jar: false,
            jar: []
        }
    )
}

// ---- run -----------------------------------------------------------------------------------

struct Reply {
    status: int,
    headers: [(string, string)],
    body: bytes,
}

/// The headers as given, in order and with repeats, except Cookie: RFC 6265 allows only one
/// Cookie line, so repeated ones are joined with "; " where the first one was.
fn header_pairs(hs: [(string, string)]) -> [(string, string)] {
    var out: [(string, string)] = [];
    var cookie_at = -1;
    for (k, v) in hs {
        if (k.to_lower() == "cookie") {
            if (cookie_at >= 0) {
                out[cookie_at] = (out[cookie_at].0, out[cookie_at].1 + "; " + v);
                continue;
            }
            cookie_at = out.len();
        }
        out.push((k, v));
    }
    out
}

/// The headers as they go out: the ones net/http writes first (Host and Connection, ours when
/// given; Accept-Encoding unless given; Content-Length from the body, which must match one given),
/// then the rest of ours.
pub fn wire_headers(p: Prepared) -> [(string, string)] {
    let given = header_pairs(p.headers);
    var out: [(string, string)] = [
        ("Host", header_value(given, "host").unwrap_or(urls.authority(p.url))),
        ("Connection", header_value(given, "connection").unwrap_or("close"))
    ];
    if (!lower_names(given).contains("accept-encoding")) {
        out.push(("Accept-Encoding", "gzip"));
    }
    if (p.body.len() > 0) {
        out.push(("Content-Length", to_string(p.body.len())));
    }
    out + without(given, ["host", "connection", "content-length"])
}

fn send_once(p: Prepared, timeout_ms: int) -> Result<Reply, string> {
    let r = http.request_pairs(
        p.method,
        urls.render(p.url),
        p.body,
        header_pairs(p.headers),
        timeout_ms
    )?;
    var headers: [(string, string)] = [];
    for (k, v) in r.raw_headers {
        headers.push((k.to_lower(), v));
    }
    Result.Ok(Reply { status: r.status, headers: headers, body: r.body })
}

pub fn is_redirect(status: int) -> bool {
    [301, 302, 303, 307, 308].contains(status)
}

pub fn header_value(hs: [(string, string)], name: string) -> Option<string> {
    let low = name.to_lower();
    for (k, v) in hs {
        if (k.to_lower() == low) {
            return Option.Some(v);
        }
    }
    Option.None
}

fn without(hs: [(string, string)], names: [string]) -> [(string, string)] {
    var out: [(string, string)] = [];
    for (k, v) in hs {
        if (!names.contains(k.to_lower())) {
            out.push((k, v));
        }
    }
    out
}

/// The request that follows a redirect, as browsers (and Go's net/http) do it: 303 turns
/// anything but HEAD into a GET without body; 301/302 do the same for a POST; 307/308 repeat
/// the method and the body. Credentials, and a Host given by hand, never cross to another origin.
pub fn follow(p: Prepared, status: int, next: urls.Url) -> Prepared {
    let to_get = (status == 303 && p.method != "HEAD")
        || ((status == 301 || status == 302) && p.method == "POST");
    var headers = p.headers;
    var body = p.body;
    var method = p.method;
    if (to_get) {
        method = "GET";
        body = b"";
        headers = without(headers, ["content-type", "content-length"]);
    }
    if (urls.origin(next) != urls.origin(p.url)) {
        headers = without(
            headers,
            ["authorization", "cookie", "proxy-authorization", "host"] + p.credentials
        );
    }
    Prepared {
        method: method,
        url: next,
        headers: headers,
        body: body,
        timeout_ms: p.timeout_ms,
        follow_redirects: p.follow_redirects,
        max_redirects: p.max_redirects,
        credentials: p.credentials,
        use_jar: p.use_jar,
        jar: p.jar
    }
}

fn sent_of(p: Prepared) -> Sent {
    Sent { method: p.method, url: urls.render(p.url), headers: wire_headers(p), body: p.body }
}

fn failed(
    p: Prepared,
    error: string,
    start: int,
    started_at: int,
    hops: [Hop],
    set_cookies: [(string, string)]
) -> Outcome {
    Outcome {
        ok: false,
        error: error,
        status: 0,
        headers: [],
        body: b"",
        duration_ms: time.monotonic_millis() - start,
        started_at: started_at,
        sent: sent_of(p),
        hops: hops,
        set_cookies: set_cookies
    }
}

/// An outcome for a request that was never sent (a step before it failed: an OAuth 2 token).
pub fn not_sent(p: Prepared, error: string) -> Outcome {
    failed(p, error, time.monotonic_millis(), time.now(), [], [])
}

/// The names in the Cookie headers the user wrote: the jar does not send those again.
fn hand_cookie_names(hs: [(string, string)]) -> [string] {
    var out: [string] = [];
    for (k, v) in hs {
        if (k.to_lower() == "cookie") {
            for part in v.split(";") {
                out.push(part.split("=")[0].trim());
            }
        }
    }
    out
}

/// `p` as it goes on the wire for this hop: plus the jar's cookies for its URL.
fn with_jar(p: Prepared, jar: [cookies.Cookie]) -> Prepared {
    if (!p.use_jar) {
        return p;
    }
    let cs = cookies.for_url(jar, p.url, time.now(), hand_cookie_names(p.headers));
    if (cs.len() == 0) {
        return p;
    }
    Prepared {
        method: p.method,
        url: p.url,
        headers: p.headers + [("Cookie", cookies.header(cs))],
        body: p.body,
        timeout_ms: p.timeout_ms,
        follow_redirects: p.follow_redirects,
        max_redirects: p.max_redirects,
        credentials: p.credentials,
        use_jar: p.use_jar,
        jar: jar
    }
}

fn set_cookie_lines(hs: [(string, string)]) -> [string] {
    var out: [string] = [];
    for (k, v) in hs {
        if (k == "set-cookie") {
            out.push(v);
        }
    }
    out
}

/// The whole exchange. The timeout covers every hop together (0 = none).
pub fn run(first: Prepared) -> Outcome {
    let start = time.monotonic_millis();
    let started_at = time.now();
    var p = first;
    var hops: [Hop] = [];
    var jar = first.jar;
    var set_cookies: [(string, string)] = [];
    while (true) {
        var budget = 0;
        if (p.timeout_ms > 0) {
            budget = p.timeout_ms - (time.monotonic_millis() - start);
            if (budget <= 0) {
                return failed(
                    with_jar(p, jar),
                    "timed out after ${p.timeout_ms} ms",
                    start,
                    started_at,
                    hops,
                    set_cookies
                );
            }
        }
        let wire = with_jar(p, jar);
        let reply = match (send_once(wire, budget)) {
            Result.Ok(r) => r,
            Result.Err(e) => return failed(wire, e, start, started_at, hops, set_cookies),
        };
        if (p.use_jar) {
            // A cookie set by a redirect (a login's 302) goes with the next hop.
            let lines = set_cookie_lines(reply.headers);
            for line in lines {
                set_cookies.push((urls.render(p.url), line));
            }
            jar = cookies.receive(jar, lines, p.url, time.now()).0;
        }
        if (p.follow_redirects && is_redirect(reply.status)) {
            if let Option.Some(loc) = header_value(reply.headers, "location") {
                if (hops.len() >= p.max_redirects) {
                    return failed(
                        wire,
                        "too many redirects (the limit is ${p.max_redirects})",
                        start,
                        started_at,
                        hops,
                        set_cookies
                    );
                }
                let next = match (urls.resolve(p.url, loc)) {
                    Result.Ok(u) => u,
                    Result.Err(e) => return failed(
                        wire,
                        "bad redirect Location '${loc}': ${e}",
                        start,
                        started_at,
                        hops,
                        set_cookies
                    ),
                };
                hops.push(
                    Hop {
                        status: reply.status,
                        method: p.method,
                        url: urls.render(p.url),
                        location: loc
                    }
                );
                p = follow(p, reply.status, next);
                continue;
            }
        }
        return Outcome {
            ok: true,
            error: "",
            status: reply.status,
            headers: reply.headers,
            body: reply.body,
            duration_ms: time.monotonic_millis() - start,
            started_at: started_at,
            sent: sent_of(wire),
            hops: hops,
            set_cookies: set_cookies
        };
    }
}
