//! The ordered document tree of the specs rayreq imports (OpenAPI, in JSON or YAML): a
//! `json.Doc`, which keeps the members in the order written and each number as its text (an id
//! like 9007199254740993 survives the trip into an example body). The yaml package reads into
//! the same type. Here: the reading helpers the importer uses.

import std/json;
import std/url;

pub type Node = json.Doc;

// ---- reading -------------------------------------------------------------------------------

/// The member `key` of an object (the last one when repeated); None for a missing key or a
/// node that is not an object.
pub fn get(n: Node, key: string) -> Option<Node> {
    json.doc_get(n, key)
}

pub fn has(n: Node, key: string) -> bool {
    get(n, key).is_some()
}

/// A scalar as text (`true`, `12`, `abc`); None for null, lists and objects.
pub fn text(n: Node) -> Option<string> {
    match (n) {
        json.Doc.Str(s) => Option.Some(s),
        json.Doc.Num(s) => Option.Some(s),
        json.Doc.Bool(b) => Option.Some(if (b) { "true" } else { "false" }),
        _ => Option.None,
    }
}

/// The text of the member `key`, or "".
pub fn str_at(n: Node, key: string) -> string {
    match (get(n, key)) {
        Option.Some(v) => text(v).unwrap_or(""),
        Option.None => "",
    }
}

pub fn bool_at(n: Node, key: string) -> bool {
    match (get(n, key)) {
        Option.Some(json.Doc.Bool(b)) => b,
        _ => false,
    }
}

/// The items of a list; [] for anything else.
pub fn items(n: Node) -> [Node] {
    json.doc_items(n)
}

/// The members of an object, in order; [] for anything else. A repeated key appears once, in
/// the place of the first, with the last value (what `get` reads).
pub fn entries(n: Node) -> [(string, Node)] {
    var out: [(string, Node)] = [];
    for m in json.doc_members(n) {
        put(out, m.key, m.value);
    }
    out
}

pub fn items_at(n: Node, key: string) -> [Node] {
    match (get(n, key)) {
        Option.Some(v) => items(v),
        Option.None => [],
    }
}

pub fn entries_at(n: Node, key: string) -> [(string, Node)] {
    match (get(n, key)) {
        Option.Some(v) => entries(v),
        Option.None => [],
    }
}

pub fn is_obj(n: Node) -> bool {
    match (n) {
        json.Doc.Obj(_) => true,
        _ => false,
    }
}

/// A local JSON Pointer (`#/components/schemas/Pet`, RFC 6901 with the `~0`/`~1` escapes and
/// URI percent-escapes) into `root`. A reference to another file is None.
pub fn pointer(root: Node, ref: string) -> Option<Node> {
    let path = ref.strip_prefix("#")?;
    if (path == "") {
        return Option.Some(root);
    }
    // The fragment is percent-encoded; each token is decoded on its own, so a `%2F` stays in
    // its token (escaped as `~1`).
    var tokens: [string] = [];
    for raw in path.strip_prefix("/")?.split("/") {
        tokens.push(url.percent_decode(raw).unwrap_or(raw).replace("/", "~1"));
    }
    json.doc_pointer(root, "/" + tokens.join("/"))
}

// ---- writing -------------------------------------------------------------------------------

/// An object from its members, in order.
pub fn obj(fields: [(string, Node)]) -> Node {
    json.Doc.Obj(
        fields.map(fn(f: (string, Node)) -> json.Member { json.Member { key: f.0, value: f.1 } })
    )
}

/// Sets `k` (a repeated key replaces the earlier value in its place).
pub fn put(fields: [(string, Node)], k: string, v: Node) {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].0 == k) {
            fields[i] = (k, v);
            return;
        }
        i = i + 1;
    }
    fields.push((k, v));
}

/// JSON text, indented by `indent` spaces a level (0 = one line). An empty object or list stays
/// `{}` / `[]`.
pub fn to_json(n: Node, indent: int) -> string {
    if (indent > 0) { json.render_doc_pretty(n, indent) } else { json.render_doc(n) }
}

/// A JSON string literal.
pub fn quote(s: string) -> string {
    json.render_doc(json.Doc.Str(s))
}

/// JSON text as a tree. `json.parse_doc` does not take a byte order mark (and calls it
/// "expected a number"): one at the start is skipped, as editors on Windows write it.
pub fn parse_json(s: string) -> Result<Node, string> {
    let text = s.strip_prefix("\u{FEFF}").unwrap_or(s);
    match (json.parse_doc(text)) {
        Result.Ok(n) => Result.Ok(n),
        Result.Err(e) => Result.Err("JSON: " + e),
    }
}
