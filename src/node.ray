//! An ordered document tree for the specs rayreq imports (OpenAPI, in JSON or YAML).
//! `std/json` keeps an object as a `Map` (keys sorted) and its numbers as floats; an import
//! needs neither: the paths keep the order they were written in, and a number keeps its text
//! (an id like 9007199254740993 survives the trip into an example body).

pub enum Node {
    Null,
    Bool(bool),
    /// The number as JSON writes it.
    Num(string),
    Str(string),
    List([Node]),
    Obj([(string, Node)]),
}

// ---- reading -------------------------------------------------------------------------------

/// The member `key` of an object; None for a missing key or a node that is not an object.
pub fn get(n: Node, key: string) -> Option<Node> {
    match (n) {
        Node.Obj(fields) => {
            for (k, v) in fields {
                if (k == key) {
                    return Option.Some(v);
                }
            }
            Option.None
        },
        _ => Option.None,
    }
}

pub fn has(n: Node, key: string) -> bool {
    get(n, key).is_some()
}

/// A scalar as text (`true`, `12`, `abc`); None for null, lists and objects.
pub fn text(n: Node) -> Option<string> {
    match (n) {
        Node.Str(s) => Option.Some(s),
        Node.Num(s) => Option.Some(s),
        Node.Bool(b) => Option.Some(if (b) { "true" } else { "false" }),
        _ => Option.None,
    }
}

/// The text of the member `key`, or "".
pub fn str_at(n: Node, key: string) -> string {
    match (get(n, key)) {
        Option.Some(v) => text(v).unwrap_or(""),
        Option.None => "",
    }
}

pub fn bool_at(n: Node, key: string) -> bool {
    match (get(n, key)) {
        Option.Some(Node.Bool(b)) => b,
        _ => false,
    }
}

/// The items of a list; [] for anything else.
pub fn items(n: Node) -> [Node] {
    match (n) {
        Node.List(xs) => xs,
        _ => [],
    }
}

/// The members of an object, in order; [] for anything else.
pub fn entries(n: Node) -> [(string, Node)] {
    match (n) {
        Node.Obj(fields) => fields,
        _ => [],
    }
}

pub fn items_at(n: Node, key: string) -> [Node] {
    match (get(n, key)) {
        Option.Some(v) => items(v),
        Option.None => [],
    }
}

pub fn entries_at(n: Node, key: string) -> [(string, Node)] {
    match (get(n, key)) {
        Option.Some(v) => entries(v),
        Option.None => [],
    }
}

pub fn is_obj(n: Node) -> bool {
    match (n) {
        Node.Obj(_) => true,
        _ => false,
    }
}

/// A local JSON Pointer (`#/components/schemas/Pet`, RFC 6901 with the `~0`/`~1` escapes and
/// URI percent-escapes) into `root`. A reference to another file is None.
pub fn pointer(root: Node, ref: string) -> Option<Node> {
    if (!ref.starts_with("#")) {
        return Option.None;
    }
    let path = ref.substring(1, ref.len());
    if (path == "") {
        return Option.Some(root);
    }
    if (!path.starts_with("/")) {
        return Option.None;
    }
    var at = root;
    for raw in path.substring(1, path.len()).split("/") {
        let token = percent_decode(raw).replace("~1", "/").replace("~0", "~");
        at = match (at) {
            Node.Obj(_) => get(at, token)?,
            Node.List(xs) => {
                let i = parse_int(token)?;
                if (i < 0 || i >= xs.len()) {
                    return Option.None;
                }
                xs[i]
            },
            _ => return Option.None,
        };
    }
    Option.Some(at)
}

fn hex_value(c: char) -> int {
    let n = char_code(c);
    if (n >= 48 && n <= 57) {
        n - 48
    } else if (n >= 97 && n <= 102) {
        n - 87
    } else if (n >= 65 && n <= 70) {
        n - 55
    } else {
        -1
    }
}

fn percent_decode(s: string) -> string {
    if (!s.contains("%")) {
        return s;
    }
    let cs = s.chars();
    var octets: [int] = [];
    var i = 0;
    while (i < cs.len()) {
        if (cs[i] == '%'
            && i + 2 < cs.len()
            && hex_value(cs[i + 1]) >= 0
            && hex_value(cs[i + 2]) >= 0) {
            octets.push(hex_value(cs[i + 1]) * 16 + hex_value(cs[i + 2]));
            i = i + 3;
        } else {
            for b in cs[i].to_string().to_bytes() {
                octets.push(b);
            }
            i = i + 1;
        }
    }
    from_utf8(bytes_of(octets)).unwrap_or(s)
}

// ---- writing -------------------------------------------------------------------------------

/// JSON text, indented by `indent` spaces a level (0 = one line). An empty object or list stays
/// `{}` / `[]`.
pub fn to_json(n: Node, indent: int) -> string {
    var parts: [string] = [];
    write(n, indent, 0, parts);
    parts.join("")
}

fn newline(indent: int, depth: int, parts: [string]) {
    if (indent > 0) {
        parts.push("\n" + " ".repeat(indent * depth));
    }
}

fn write(n: Node, indent: int, depth: int, parts: [string]) {
    match (n) {
        Node.Null => parts.push("null"),
        Node.Bool(b) => parts.push(if (b) { "true" } else { "false" }),
        Node.Num(s) => parts.push(s),
        Node.Str(s) => parts.push(quote(s)),
        Node.List(xs) => {
            if (xs.len() == 0) {
                parts.push("[]");
                return;
            }
            parts.push("[");
            var first = true;
            for x in xs {
                if (!first) {
                    parts.push(",");
                }
                first = false;
                newline(indent, depth + 1, parts);
                write(x, indent, depth + 1, parts);
            }
            newline(indent, depth, parts);
            parts.push("]");
        },
        Node.Obj(fields) => {
            if (fields.len() == 0) {
                parts.push("{}");
                return;
            }
            parts.push("{");
            var first = true;
            for (k, v) in fields {
                if (!first) {
                    parts.push(",");
                }
                first = false;
                newline(indent, depth + 1, parts);
                parts.push(quote(k));
                parts.push(if (indent > 0) { ": " } else { ":" });
                write(v, indent, depth + 1, parts);
            }
            newline(indent, depth, parts);
            parts.push("}");
        },
    }
}

const HEX: string = "0123456789abcdef";

/// A JSON string literal.
pub fn quote(s: string) -> string {
    let cs = s.chars();
    var plain = true;
    for c in cs {
        if (c == '"' || c == '\\' || char_code(c) < 32) {
            plain = false;
            break;
        }
    }
    if (plain) {
        return "\"" + s + "\"";
    }
    var parts: [string] = ["\""];
    for c in cs {
        let n = char_code(c);
        if (c == '"') {
            parts.push("\\\"");
        } else if (c == '\\') {
            parts.push("\\\\");
        } else if (c == '\n') {
            parts.push("\\n");
        } else if (c == '\r') {
            parts.push("\\r");
        } else if (c == '\t') {
            parts.push("\\t");
        } else if (n < 32) {
            parts.push("\\u00" + HEX[n / 16].to_string() + HEX[n % 16].to_string());
        } else {
            parts.push(c.to_string());
        }
    }
    parts.push("\"");
    parts.join("")
}

// ---- JSON ----------------------------------------------------------------------------------

struct Reader {
    cs: [char],
    pos: int,
}

const MAX_DEPTH: int = 256;

/// JSON text as a tree (RFC 8259; the keys keep their order; a repeated key keeps its last
/// value, in the place of the first).
pub fn parse_json(s: string) -> Result<Node, string> {
    var r = Reader { cs: s.chars(), pos: 0 };
    if (r.cs.len() > 0 && char_code(r.cs[0]) == 0xFEFF) {
        r.pos = 1;
    }
    skip_ws(r);
    let n = value(r, 0)?;
    skip_ws(r);
    if (r.pos < r.cs.len()) {
        return fail(r, "unexpected text after the document");
    }
    Result.Ok(n)
}

/// "JSON, line 3 column 7: …".
fn fail<T>(r: Reader, what: string) -> Result<T, string> {
    var line = 1;
    var col = 1;
    var i = 0;
    while (i < r.pos && i < r.cs.len()) {
        if (r.cs[i] == '\n') {
            line = line + 1;
            col = 1;
        } else {
            col = col + 1;
        }
        i = i + 1;
    }
    Result.Err("JSON, line ${line} column ${col}: ${what}")
}

fn skip_ws(r: Reader) {
    while (r.pos < r.cs.len()) {
        let c = r.cs[r.pos];
        if (c != ' ' && c != '\n' && c != '\r' && c != '\t') {
            return;
        }
        r.pos = r.pos + 1;
    }
}

fn peek(r: Reader) -> char {
    if (r.pos < r.cs.len()) { r.cs[r.pos] } else { '\0' }
}

fn word(r: Reader, w: string, n: Node) -> Result<Node, string> {
    for c in w.chars() {
        if (peek(r) != c) {
            return fail(r, "expected '${w}'");
        }
        r.pos = r.pos + 1;
    }
    Result.Ok(n)
}

fn value(r: Reader, depth: int) -> Result<Node, string> {
    if (depth > MAX_DEPTH) {
        return fail(r, "nested too deep");
    }
    let c = peek(r);
    if (c == '{') {
        r.pos = r.pos + 1;
        var fields: [(string, Node)] = [];
        skip_ws(r);
        if (peek(r) == '}') {
            r.pos = r.pos + 1;
            return Result.Ok(Node.Obj(fields));
        }
        while (true) {
            skip_ws(r);
            if (peek(r) != '"') {
                return fail(r, "expected a key in quotes");
            }
            let k = string_lit(r)?;
            skip_ws(r);
            if (peek(r) != ':') {
                return fail(r, "expected ':'");
            }
            r.pos = r.pos + 1;
            skip_ws(r);
            let v = value(r, depth + 1)?;
            put(fields, k, v);
            skip_ws(r);
            let d = peek(r);
            r.pos = r.pos + 1;
            if (d == '}') {
                return Result.Ok(Node.Obj(fields));
            }
            if (d != ',') {
                r.pos = r.pos - 1;
                return fail(r, "expected ',' or '}'");
            }
        }
    }
    if (c == '[') {
        r.pos = r.pos + 1;
        var xs: [Node] = [];
        skip_ws(r);
        if (peek(r) == ']') {
            r.pos = r.pos + 1;
            return Result.Ok(Node.List(xs));
        }
        while (true) {
            skip_ws(r);
            xs.push(value(r, depth + 1)?);
            skip_ws(r);
            let d = peek(r);
            r.pos = r.pos + 1;
            if (d == ']') {
                return Result.Ok(Node.List(xs));
            }
            if (d != ',') {
                r.pos = r.pos - 1;
                return fail(r, "expected ',' or ']'");
            }
        }
    }
    if (c == '"') {
        return Result.Ok(Node.Str(string_lit(r)?));
    }
    if (c == 't') {
        return word(r, "true", Node.Bool(true));
    }
    if (c == 'f') {
        return word(r, "false", Node.Bool(false));
    }
    if (c == 'n') {
        return word(r, "null", Node.Null);
    }
    if (c == '-' || (c >= '0' && c <= '9')) {
        return number(r);
    }
    if (r.pos >= r.cs.len()) {
        return fail(r, "unexpected end of the text");
    }
    fail(r, "unexpected '${c}'")
}

/// Sets `k` (a repeated key replaces the earlier value in its place).
pub fn put(fields: [(string, Node)], k: string, v: Node) {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].0 == k) {
            fields[i] = (k, v);
            return;
        }
        i = i + 1;
    }
    fields.push((k, v));
}

fn digits(r: Reader) -> int {
    let start = r.pos;
    while (peek(r) >= '0' && peek(r) <= '9') {
        r.pos = r.pos + 1;
    }
    r.pos - start
}

fn number(r: Reader) -> Result<Node, string> {
    let start = r.pos;
    if (peek(r) == '-') {
        r.pos = r.pos + 1;
    }
    if (peek(r) == '0') {
        r.pos = r.pos + 1;
    } else if (digits(r) == 0) {
        return fail(r, "expected a digit");
    }
    if (peek(r) == '.') {
        r.pos = r.pos + 1;
        if (digits(r) == 0) {
            return fail(r, "expected a digit after '.'");
        }
    }
    if (peek(r) == 'e' || peek(r) == 'E') {
        r.pos = r.pos + 1;
        if (peek(r) == '+' || peek(r) == '-') {
            r.pos = r.pos + 1;
        }
        if (digits(r) == 0) {
            return fail(r, "expected a digit in the exponent");
        }
    }
    Result.Ok(Node.Num(join_chars(r.cs, start, r.pos)))
}

/// `cs[from..to]` as a string (`substring` walks the text from its start: too slow on a long
/// text read piece by piece).
pub fn join_chars(cs: [char], from: int, to: int) -> string {
    var parts: [string] = [];
    var i = from;
    while (i < to) {
        parts.push(cs[i].to_string());
        i = i + 1;
    }
    parts.join("")
}

fn hex4(r: Reader) -> Result<int, string> {
    var v = 0;
    for _ in 0..4 {
        let h = hex_value(peek(r));
        if (h < 0) {
            return fail(r, "expected four hex digits after \\u");
        }
        v = v * 16 + h;
        r.pos = r.pos + 1;
    }
    Result.Ok(v)
}

fn string_lit(r: Reader) -> Result<string, string> {
    r.pos = r.pos + 1;
    var parts: [string] = [];
    var run = r.pos;
    while (true) {
        if (r.pos >= r.cs.len()) {
            return fail(r, "unterminated string");
        }
        let c = r.cs[r.pos];
        if (c == '"') {
            parts.push(join_chars(r.cs, run, r.pos));
            r.pos = r.pos + 1;
            return Result.Ok(parts.join(""));
        }
        if (char_code(c) < 32) {
            return fail(r, "a control character inside a string");
        }
        if (c != '\\') {
            r.pos = r.pos + 1;
            continue;
        }
        parts.push(join_chars(r.cs, run, r.pos));
        r.pos = r.pos + 1;
        let e = peek(r);
        r.pos = r.pos + 1;
        match (e) {
            '"' => parts.push("\""),
            '\\' => parts.push("\\"),
            '/' => parts.push("/"),
            'b' => parts.push("\u{8}"),
            'f' => parts.push("\u{C}"),
            'n' => parts.push("\n"),
            'r' => parts.push("\r"),
            't' => parts.push("\t"),
            'u' => {
                var code = hex4(r)?;
                if (code >= 0xD800 && code <= 0xDBFF && peek(r) == '\\') {
                    let back = r.pos;
                    r.pos = r.pos + 1;
                    if (peek(r) == 'u') {
                        r.pos = r.pos + 1;
                        let low = hex4(r)?;
                        if (low >= 0xDC00 && low <= 0xDFFF) {
                            code = 0x10000 + (code - 0xD800) * 1024 + (low - 0xDC00);
                        } else {
                            r.pos = back;
                        }
                    } else {
                        r.pos = back;
                    }
                }
                // A lone surrogate is not a character: U+FFFD stands for it.
                // U+FFFD by number: `ray fmt` turns the escape into the character itself.
                parts.push(char_from_code(code).unwrap_or(0xFFFD as char).to_string());
            },
            _ => {
                r.pos = r.pos - 1;
                return fail(r, "invalid escape");
            },
        }
        run = r.pos;
    }
}
