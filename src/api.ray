//! The page ↔ program protocol over `window.ray.request({op, …})`. Every request is answered
//! with `{ok: true, value}` or `{ok: false, error}`. This module never touches the window: it
//! returns an `Action`, and the main loop does what needs the window or a fiber (send a
//! request, open a save dialog, quit).
//!
//!   bootstrap                                → {projects, settings, version}
//!   projects.list · projects.create {name, description, environment}
//!   projects.update {id, name, description} · projects.delete {id}
//!   environments.list {project_id} · environments.create {project_id, name, copy_from}
//!   environments.rename {id, name} · environments.activate {id} · environments.delete {id}
//!   environments.variables {id} · environments.save_variables {id, variables}
//!   folders.variables {id, environment_id} · folders.save_variables {id, environment_id,
//!     variables}                             (environment_id 0 = the folder's defaults)
//!   folders.auth {id} · folders.save_auth {id, auth}
//!   cookies.list {environment_id} · cookies.delete {environment_id, name, domain, path}
//!   cookies.clear {environment_id}
//!   curl.parse {text}                        → {request (a draft), warnings}
//!   curl.export {request}                    → {command, missing}
//!   openapi.import {project_id, folder_id, path | text}
//!                                            → {folder_id, title, requests, folders, warnings}
//!                                              (read and converted in a fiber)
//!   runner.plan {project_id, folder_id}     → {name, steps: [{id, name, method, path}]}: what a
//!                                              run sends, in order (the page sends each one)
//!   oauth.status {request | project_id, folder_id, auth} → the token the auth would send
//!   oauth.token {run, request | project_id, folder_id, auth} → the same, after getting a new
//!                                              token (in a fiber; the code flow opens the browser)
//!   oauth.cancel {run} · oauth.clear {request | project_id, folder_id, auth}
//!   variables {project_id, folder_id | request} → {environment, variables, missing, url, auth}
//!   tree {project_id}                        → {folders, requests}
//!   folders.create {project_id, parent_id, name} · folders.rename {id, name}
//!   folders.move {id, parent_id} · folders.delete {id}
//!   requests.create {project_id, folder_id, name} · requests.get {id}
//!   requests.save {request} · requests.rename {id, name} · requests.move {id, folder_id}
//!   requests.duplicate {id} · requests.delete {id}
//!   send {run, request}                      → the response (answered when it arrives), with
//!                                              {unresolved, captures, assertions, environment,
//!                                               cookies_stored, cookies_ignored}
//!   cancel {run}                             → the pending send answers {cancelled: true}
//!   history.list {request_id} · history.get {id} · history.clear {request_id}
//!   body.save {history_id}                   → the path, or null when cancelled
//!   settings.set {key, value} · clipboard.write {text} · url.open {url} · log {message} · quit
//!   appearance {mode}                        → the system's menus and dialogs follow the page's
//!                                              theme: "system", "light" or "dark"
//!   updates.check                            → the newer release for this platform, or null
//!                                              (checked in a fiber; an untrusted manifest fails)
//!   updates.install {release}                → {restarting: true} once the release (as
//!                                              updates.check gave it) is downloaded, verified
//!                                              and applied; RayReq then relaunches and exits

import std/fs;
import std/json;
import std/time;
import std/update;
import assertions;
import auth;
import captures;
import cookies;
import curl;
import exec;
import jsonv;
import model;
import oauth;
import openapi;
import runner;
import store;
import updates;
import urls;
import vars;
import view;

pub const VERSION: string = "0.1.7";

/// The settings the page may write. `tabs.<project id>` keeps the open tabs of a project;
/// `block_unresolved` = "1" refuses to send a request with an unresolved `{{name}}`;
/// `skip_update` is the version the user chose not to be told about again.
fn allowed_setting(key: string) -> bool {
    key == "language"
        || key == "last_project"
        || key == "block_unresolved"
        || key == "skip_update"
        || key.starts_with("tabs.")
}

/// A send, ready to run in a fiber: what the main loop needs to answer it when it finishes.
pub struct Job {
    /// The page's id for this send (cancel names it).
    run: int,
    /// 0 = an unsaved draft: no history.
    request_id: int,
    prepared: exec.Prepared,
    /// The environment the variables came from (0 = none): the captures write there.
    environment_id: int,
    environment: string,
    captures: [model.Pair],
    /// Resolved, with the names each one left unresolved.
    assertions: [(model.Assertion, [string])],
    unresolved: [string],
    /// An OAuth 2 token to get (or refresh) before sending; the fiber does it.
    oauth: Option<OAuthFetch>,
    /// The token the fiber got: `finish` keeps it.
    token: Option<oauth.Token>,
}

/// An OAuth 2 token a send needs and can get without the user.
pub struct OAuthFetch {
    /// The resolved settings.
    auth: model.Auth,
    owner: string,
    stored: Option<oauth.Token>,
}

/// Getting a token for the page ("Get new token"); the main loop opens the browser for the
/// code flow.
pub struct OAuthJob {
    run: int,
    environment_id: int,
    owner: string,
    auth: model.Auth,
}

pub enum Action {
    /// Answer now with this JSON.
    Reply(string),
    /// Send the request in a fiber.
    Send(Job),
    /// Answer the pending send `run` with "cancelled", then answer this request.
    Cancel(int),
    /// Ask where to save the body of a history entry, then write it.
    SaveBody(int),
    /// The page's language changed: rebuild the menus, then answer.
    Language(string),
    /// The page's theme changed: the native pieces (popup menus, dialogs) follow it.
    Appearance(string),
    Clipboard(string),
    /// Read and convert an API description in a fiber, then `store_spec`.
    ImportSpec(SpecJob),
    /// Get an OAuth 2 token (the code flow opens the browser first), then `keep_token`.
    OAuth(OAuthJob),
    /// Stop waiting for the browser of the token request `run`, then answer this request.
    OAuthCancel(int),
    /// Open the URL in the system browser.
    OpenUrl(string),
    /// Fetch the update manifest in a fiber, then answer with the newer release or null.
    CheckUpdate,
    /// Download the release in a fiber; then apply it, answer, relaunch and exit.
    InstallUpdate(update.Release),
    Quit,
}

/// An API description to import into `folder_id` (0 = the project's top): the file at `path`,
/// or `text` as pasted.
pub struct SpecJob {
    project_id: int,
    folder_id: int,
    path: string,
    text: string,
}

/// The fiber's half of an import: read the file and convert it (no store here).
pub fn read_spec(job: SpecJob) -> Result<openapi.Imported, string> {
    var text = job.text;
    if (job.path != "") {
        let st = fs.stat(job.path)?;
        if (st.size > openapi.MAX_SIZE) {
            return Result.Err("the file is too large (32 MB at most)");
        }
        text = fs.read_file(job.path)?;
    }
    openapi.parse(text)
}

/// The main loop's half: the folders and requests, in one transaction.
pub fn store_spec(
    s: store.Store,
    job: SpecJob,
    imported: Result<openapi.Imported, string>
) -> string {
    let i = match (imported) {
        Result.Ok(i) => i,
        Result.Err(e) => return fail(e),
    };
    let written = store.tx(s, fn() -> Result<(model.Folder, int), string> {
        let top = store.create_folder(s, job.project_id, job.folder_id, i.title)?;
        store.save_folder_variables(s, top.id, 0, i.variables)?;
        if (i.auth.kind != "inherit") {
            store.save_folder_auth(s, top.id, i.auth)?;
        }
        for r in i.requests {
            add_imported(s, job.project_id, top.id, r)?;
        }
        var folders = 1;
        for g in i.groups {
            let f = store.create_folder(s, job.project_id, top.id, g.name)?;
            folders = folders + 1;
            for r in g.requests {
                add_imported(s, job.project_id, f.id, r)?;
            }
        }
        Result.Ok((top, folders))
    });
    match (written) {
        Result.Ok((top, folders)) => ok(
            jsonv.obj(
                [
                    ("folder_id", jsonv.num(top.id)),
                    ("title", jsonv.str(top.name)),
                    ("requests", jsonv.num(openapi.count(i))),
                    ("folders", jsonv.num(folders)),
                    ("warnings", jsonv.strs(i.warnings))
                ]
            )
        ),
        Result.Err(e) => fail(e),
    }
}

fn add_imported(
    s: store.Store,
    project_id: int,
    folder_id: int,
    r: model.Request
) -> Result<model.Request, string> {
    var x = r.clone();
    x.project_id = project_id;
    x.folder_id = folder_id;
    store.create_request(s, x)
}

// ---- OAuth 2 tokens for the page -----------------------------------------------------------

/// Whose token the page asks about, with the settings resolved: a request's effective auth
/// (its own or inherited: then the folder's token), or a folder's auth as edited in its dialog.
struct OAuthTarget {
    environment_id: int,
    environment: string,
    owner: string,
    auth: model.Auth,
    missing: [string],
    from: string,
    source: string,
}

fn oauth_target(s: store.Store, req: json.Json) -> Result<OAuthTarget, string> {
    let (sc, owner, a, from, source) = if let Option.Some(j) = json.member(req, "request") {
        let r = model.request_of(j)?;
        let (project_id, folder_id) = vars.location(s, r)?;
        let eff = auth.effective(s, r, folder_id)?;
        if (eff.auth.kind != "oauth2") {
            return Result.Err("this request does not use OAuth 2");
        }
        if (eff.owner == "request:0") {
            return Result.Err("OAuth 2: save the request before getting a token for it");
        }
        (vars.scope(s, project_id, folder_id)?, eff.owner, eff.auth, eff.from, eff.source)
    } else {
        let folder_id = jsonv.need_int(req, "folder_id")?;
        let f = store.get_folder(s, folder_id)?;
        let a = model.auth_of(jsonv.need_obj(req, "auth")?)?;
        if (a.kind != "oauth2") {
            return Result.Err("this folder does not use OAuth 2");
        }
        (vars.scope(s, f.project_id, folder_id)?, store.owner_of(folder_id, 0), a, "folder", f.name)
    };
    // The settings resolved like a send's (the same resolver), on a request that has nothing else.
    var carrier = model.new_request(0, 0, "");
    carrier.auth = a;
    let (resolved, missing) = vars.resolve_request(carrier, sc.vars);
    Result.Ok(
        OAuthTarget {
            environment_id: sc.environment_id,
            environment: sc.environment,
            owner: owner,
            auth: resolved.auth,
            missing: missing,
            from: from,
            source: source
        }
    )
}

fn oauth_status(s: store.Store, x: OAuthTarget) -> Result<json.Json, string> {
    let stored = store.get_token(s, x.environment_id, x.owner)?;
    let token = match (stored) {
        Option.Some(t) => oauth.token_info(t, x.auth, time.now()),
        Option.None => jsonv.obj([("has_token", jsonv.flag(false))]),
    };
    Result.Ok(
        jsonv.obj(
            [
                ("environment", jsonv.str(x.environment)),
                ("from", jsonv.str(x.from)),
                ("source", jsonv.str(x.source)),
                ("grant", jsonv.str(x.auth.grant)),
                ("missing", jsonv.strs(x.missing)),
                ("token", token),
                ("automatic", jsonv.flag(oauth.can_fetch(x.auth, stored)))
            ]
        )
    )
}

fn oauth_job(s: store.Store, req: json.Json) -> Result<OAuthJob, string> {
    let x = oauth_target(s, req)?;
    if (x.missing.len() > 0) {
        return Result.Err("OAuth 2: not defined: ${x.missing.join(", ")}");
    }
    Result.Ok(
        OAuthJob {
            run: jsonv.need_int(req, "run")?,
            environment_id: x.environment_id,
            owner: x.owner,
            auth: x.auth
        }
    )
}

/// The fiber's part of "Get new token" for the grants without a browser.
pub fn obtain(job: OAuthJob) -> Result<oauth.Token, string> {
    oauth.request_token(job.auth, oauth.grant_fields(job.auth)?, "")
}

/// Keeps the token the fiber got and answers with its status.
pub fn keep_token(s: store.Store, job: OAuthJob, got: Result<oauth.Token, string>) -> string {
    let t = match (got) {
        Result.Ok(t) => t,
        Result.Err(e) => return fail(e),
    };
    if let Result.Err(e) = store.save_token(s, job.environment_id, job.owner, t) {
        return fail(e);
    }
    ok(oauth.token_info(t, job.auth, time.now()))
}

fn spec_job(s: store.Store, req: json.Json) -> Result<SpecJob, string> {
    let project_id = jsonv.need_int(req, "project_id")?;
    store.get_project(s, project_id)?;
    let folder_id = jsonv.get_int(req, "folder_id");
    if (folder_id != 0 && store.get_folder(s, folder_id)?.project_id != project_id) {
        return Result.Err("the folder is not in this project");
    }
    let job = SpecJob {
        project_id: project_id,
        folder_id: folder_id,
        path: jsonv.get_str(req, "path"),
        text: jsonv.get_str(req, "text")
    };
    if (job.path == "" && job.text.trim() == "") {
        return Result.Err("nothing to import: give a file or paste the description");
    }
    Result.Ok(job)
}

pub fn ok(value: json.Json) -> string {
    json.stringify(jsonv.obj([("ok", jsonv.flag(true)), ("value", value)]))
}

pub fn fail(msg: string) -> string {
    json.stringify(jsonv.obj([("ok", jsonv.flag(false)), ("error", jsonv.str(msg))]))
}

pub fn cancelled() -> string {
    json.stringify(
        jsonv.obj(
            [
                ("ok", jsonv.flag(false)),
                ("cancelled", jsonv.flag(true)),
                ("error", jsonv.str("cancelled"))
            ]
        )
    )
}

fn projects_json(s: store.Store) -> Result<json.Json, string> {
    var out: [json.Json] = [];
    for p in store.list_projects(s)? {
        out.push(model.project_json(p));
    }
    Result.Ok(jsonv.arr(out))
}

fn tree_json(s: store.Store, project_id: int) -> Result<json.Json, string> {
    store.get_project(s, project_id)?;
    var folders: [json.Json] = [];
    for f in store.list_folders(s, project_id)? {
        folders.push(model.folder_json(f));
    }
    var requests: [json.Json] = [];
    for r in store.list_requests(s, project_id)? {
        requests.push(model.request_summary_json(r));
    }
    Result.Ok(jsonv.obj([("folders", jsonv.arr(folders)), ("requests", jsonv.arr(requests))]))
}

fn runner_plan(s: store.Store, project_id: int, folder_id: int) -> Result<json.Json, string> {
    let project = store.get_project(s, project_id)?;
    let name = if (folder_id == 0) {
        project.name
    } else {
        let f = store.get_folder(s, folder_id)?;
        if (f.project_id != project_id) {
            return Result.Err("the folder is not in this project");
        }
        f.name
    };
    var steps: [json.Json] = [];
    for st in runner.order(
        store.list_folders(s, project_id)?,
        store.list_requests(s, project_id)?,
        folder_id
    ) {
        steps.push(
            jsonv.obj(
                [
                    ("id", jsonv.num(st.request.id)),
                    ("name", jsonv.str(st.request.name)),
                    ("method", jsonv.str(st.request.method)),
                    ("path", jsonv.str(st.path))
                ]
            )
        );
    }
    Result.Ok(jsonv.obj([("name", jsonv.str(name)), ("steps", jsonv.arr(steps))]))
}

fn history_json(items: [store.HistoryItem]) -> json.Json {
    var out: [json.Json] = [];
    for h in items {
        out.push(
            jsonv.obj(
                [
                    ("id", jsonv.num(h.id)),
                    ("executed_at", jsonv.num(h.executed_at)),
                    ("method", jsonv.str(h.method)),
                    ("url", jsonv.str(h.url)),
                    ("status", jsonv.num(h.status)),
                    ("status_text", jsonv.str(view.status_text(h.status))),
                    ("ok", jsonv.flag(h.ok)),
                    ("duration_ms", jsonv.num(h.duration_ms)),
                    ("size", jsonv.num(h.size))
                ]
            )
        );
    }
    jsonv.arr(out)
}

fn bootstrap(s: store.Store) -> Result<json.Json, string> {
    var settings: [(string, json.Json)] = [];
    for (k, v) in store.all_settings(s)? {
        settings.push((k, jsonv.str(v)));
    }
    Result.Ok(
        jsonv.obj(
            [
                ("projects", projects_json(s)?),
                ("settings", jsonv.obj(settings)),
                ("version", jsonv.str(VERSION)),
                ("methods", jsonv.strs(model.METHODS))
            ]
        )
    )
}

/// The history entry of a finished send, ready for the store.
pub fn history_item(o: exec.Outcome) -> store.HistoryItem {
    store.HistoryItem {
        id: 0,
        request_id: 0,
        executed_at: o.started_at,
        method: o.sent.method,
        url: o.sent.url,
        status: o.status,
        ok: o.ok,
        duration_ms: o.duration_ms,
        size: o.body.len()
    }
}

/// A finished send: runs its captures, stores it in the request's history (when it has one)
/// and renders the reply.
pub fn finish(s: store.Store, job: Job, o: exec.Outcome) -> string {
    var oauth_note = "";
    if let Option.Some(t) = job.token {
        if let Option.Some(f) = job.oauth {
            match (store.save_token(s, job.environment_id, f.owner, t)) {
                Result.Ok(_) => oauth_note = "obtained",
                Result.Err(e) => oauth_note = "the token could not be kept: ${e}",
            }
        }
    }
    let captured = captures.apply(s, job.environment_id, job.captures, o);
    let checked = assertions.check(job.assertions, o);
    let (stored, ignored) = keep_cookies(s, job, o);
    var history_id = 0;
    if (job.request_id > 0) {
        match (store.add_history(s, job.request_id, history_item(o), view.record(o))) {
            Result.Ok(id) => history_id = id,
            // A request deleted while its send was running has no history to write to.
            Result.Err(e) => eprint("rayreq: history: " + e),
        }
    }
    ok(
        view.present_with(
            o,
            history_id,
            [
                ("unresolved", jsonv.strs(job.unresolved)),
                ("captures", captures.captured_json(captured)),
                ("assertions", assertions.checked_json(checked)),
                ("environment", jsonv.str(job.environment)),
                ("cookies_stored", jsonv.num(stored)),
                ("cookies_ignored", jsonv.strs(ignored)),
                ("oauth", jsonv.str(oauth_note))
            ]
        )
    )
}

/// Applies the Set-Cookie lines of a finished send to the environment's stored jar (read again
/// now: another send may have changed it meanwhile). How many lines were kept, and why the
/// others were ignored.
fn keep_cookies(s: store.Store, job: Job, o: exec.Outcome) -> (int, [string]) {
    if (!job.prepared.use_jar || o.set_cookies.len() == 0) {
        return (0, []);
    }
    var jar = match (store.list_cookies(s, job.environment_id)) {
        Result.Ok(j) => j,
        Result.Err(e) => return (0, ["the cookie jar could not be read: ${e}"]),
    };
    var ignored: [string] = [];
    for (from, line) in o.set_cookies {
        match (urls.parse(from)) {
            Result.Ok(u) => {
                let (next, why) = cookies.receive(jar, [line], u, o.started_at + o.duration_ms);
                jar = next;
                ignored = ignored + why;
            },
            Result.Err(e) => ignored.push(e),
        }
    }
    if let Result.Err(e) = store.save_cookies(s, job.environment_id, jar) {
        return (0, ignored + ["the cookie jar could not be saved: ${e}"]);
    }
    (o.set_cookies.len() - ignored.len(), ignored)
}

pub fn cookies_json(cs: [cookies.Cookie]) -> json.Json {
    var out: [json.Json] = [];
    for c in cs {
        out.push(
            jsonv.obj(
                [
                    ("name", jsonv.str(c.name)),
                    ("value", jsonv.str(c.value)),
                    ("domain", jsonv.str(c.domain)),
                    ("host_only", jsonv.flag(c.host_only)),
                    ("path", jsonv.str(c.path)),
                    ("expires", jsonv.num(c.expires)),
                    ("secure", jsonv.flag(c.secure)),
                    ("http_only", jsonv.flag(c.http_only)),
                    ("same_site", jsonv.str(c.same_site))
                ]
            )
        );
    }
    jsonv.arr(out)
}

fn environments_json(s: store.Store, project_id: int) -> Result<json.Json, string> {
    store.get_project(s, project_id)?;
    var out: [json.Json] = [];
    for e in store.list_environments(s, project_id)? {
        out.push(model.environment_json(e));
    }
    Result.Ok(jsonv.arr(out))
}

fn variables_list_json(vs: [vars.Var]) -> json.Json {
    var out: [json.Json] = [];
    for v in vs {
        out.push(
            jsonv.obj(
                [
                    ("key", jsonv.str(v.key)),
                    ("value", jsonv.str(v.value)),
                    ("kind", jsonv.str(v.kind)),
                    ("source", jsonv.str(v.source))
                ]
            )
        );
    }
    jsonv.arr(out)
}

/// What a send of `r` would put on the wire, before `exec.prepare`: the variables in scope, the
/// auth that applies, the request with both resolved and applied, and the names left
/// unresolved. The page's Variables tab and the send both come from here (R7).
struct Plan {
    scope: vars.Scope,
    auth: auth.Effective,
    request: model.Request,
    credentials: [string],
    missing: [string],
    /// OAuth 2: a token to get before the send, or why the send cannot have one ("" = fine).
    oauth: Option<OAuthFetch>,
    oauth_blocked: string,
}

fn plan(s: store.Store, r: model.Request) -> Result<Plan, string> {
    let (project_id, folder_id) = vars.location(s, r)?;
    // A store error here fails: never an empty scope or a silently missing auth (R4).
    let sc = vars.scope(s, project_id, folder_id)?;
    let eff = auth.effective(s, r, folder_id)?;
    var with_auth = r.clone();
    with_auth.auth = eff.auth;
    let (resolved, missing) = vars.resolve_request(with_auth, sc.vars);
    var to_apply = resolved;
    var fetch: Option<OAuthFetch> = Option.None;
    var blocked = "";
    if (eff.auth.kind == "oauth2") {
        // The token is kept apart; the request only gets its header (a hand-written
        // Authorization wins, as for the other kinds).
        let settings = resolved.auth;
        to_apply = resolved.clone();
        to_apply.auth = model.auth_of_kind("none");
        let stored = if (eff.owner == "request:0") {
            Option.None
        } else {
            store.get_token(s, sc.environment_id, eff.owner)?
        };
        let now = time.now();
        let ready = match (stored) {
            Option.Some(t) => if (oauth.usable(t, settings, now)) {
                Option.Some(t)
            } else {
                Option.None
            },
            Option.None => Option.None,
        };
        match (ready) {
            Option.Some(t) => {
                to_apply.headers = with_header(resolved.headers, "Authorization", oauth.header(t));
            },
            Option.None => {
                if (eff.owner == "request:0") {
                    blocked = "OAuth 2: save the request before getting a token for it";
                } else if (oauth.can_fetch(settings, stored)) {
                    fetch = Option.Some(
                        OAuthFetch { auth: settings, owner: eff.owner, stored: stored }
                    );
                } else {
                    blocked = "OAuth 2: no token yet (or it expired): get one in the Auth tab";
                }
            },
        }
    }
    let (applied, credentials) = auth.apply(to_apply)?;
    Result.Ok(
        Plan {
            scope: sc,
            auth: eff,
            request: applied,
            credentials: credentials,
            missing: missing,
            oauth: fetch,
            oauth_blocked: blocked
        }
    )
}

/// `headers` plus `name: value`, unless an enabled row already sets `name`.
fn with_header(headers: [model.Pair], name: string, value: string) -> [model.Pair] {
    for h in headers {
        if (h.enabled && h.key.trim().to_lower() == name.to_lower()) {
            return headers;
        }
    }
    headers + [model.Pair { key: name, value: value, enabled: true }]
}

/// The fiber's part of a send: the OAuth 2 token first when one is needed, then the exchange.
/// The job comes back with the token it got, for `finish` to keep.
pub fn execute(job: Job) -> (Job, exec.Outcome) {
    var j = job;
    if let Option.Some(f) = job.oauth {
        match (oauth.fetch(f.auth, f.stored)) {
            Result.Ok(t) => {
                j.token = Option.Some(t);
                var p = j.prepared;
                let names = p.headers.map(fn(h: (string, string)) -> string { h.0.to_lower() });
                if (!names.contains("authorization")) {
                    p.headers = p.headers + [("Authorization", oauth.header(t))];
                }
                j.prepared = p;
            },
            Result.Err(e) => return (j, exec.not_sent(j.prepared, e)),
        }
    }
    let o = exec.run(j.prepared);
    (j, o)
}

fn effective_auth_json(e: auth.Effective) -> json.Json {
    jsonv.obj(
        [
            ("kind", jsonv.str(e.auth.kind)),
            ("from", jsonv.str(e.from)),
            ("source", jsonv.str(e.source))
        ]
    )
}

/// The variables a request (or a folder) sees, from the same code the send uses (R7). With a
/// `request`, also what is left unresolved in it, its resolved URL and its auth.
fn variables(s: store.Store, req: json.Json) -> Result<json.Json, string> {
    if let Option.Some(j) = json.member(req, "request") {
        let p = plan(s, model.request_of(j)?)?;
        return Result.Ok(
            jsonv.obj(
                [
                    ("environment_id", jsonv.num(p.scope.environment_id)),
                    ("environment", jsonv.str(p.scope.environment)),
                    ("variables", variables_list_json(p.scope.vars)),
                    ("missing", jsonv.strs(p.missing)),
                    ("url", jsonv.str(p.request.url)),
                    ("auth", effective_auth_json(p.auth))
                ]
            )
        );
    }
    let sc = vars.scope(s, jsonv.need_int(req, "project_id")?, jsonv.get_int(req, "folder_id"))?;
    Result.Ok(
        jsonv.obj(
            [
                ("environment_id", jsonv.num(sc.environment_id)),
                ("environment", jsonv.str(sc.environment)),
                ("variables", variables_list_json(sc.vars))
            ]
        )
    )
}

/// What a send of `r` would put on the wire, as a curl command: the same plan (variables, auth)
/// and the jar's cookies for its URL.
fn curl_export(s: store.Store, r: model.Request) -> Result<json.Json, string> {
    let p = plan(s, r)?;
    var prepared = exec.prepare(p.request)?;
    var cookie = "";
    if (r.use_cookies && p.scope.environment_id != 0) {
        let jar = store.list_cookies(s, p.scope.environment_id)?;
        cookie = cookies.header(cookies.for_url(jar, prepared.url, time.now(), []));
    }
    Result.Ok(
        jsonv.obj(
            [
                (
                    "command",
                    jsonv.str(
                        curl.command(
                            prepared,
                            cookie,
                            if (p.request.body_type == "multipart") { p.request.parts } else { [] }
                        )
                    )
                ),
                ("missing", jsonv.strs(p.missing))
            ]
        )
    )
}

fn blocks_unresolved(s: store.Store) -> Result<bool, string> {
    Result.Ok(store.get_setting(s, "block_unresolved")?.unwrap_or("0") == "1")
}

/// The pipeline of a send: plan (resolve + auth, on a copy) → prepare → the job for a fiber.
fn prepare_send(s: store.Store, req: json.Json) -> Result<Job, string> {
    let run = jsonv.need_int(req, "run")?;
    let r = model.request_of(jsonv.need_obj(req, "request")?)?;
    let p = plan(s, r)?;
    let missing = p.missing;
    let names = missing.join(", ");
    if (missing.len() > 0 && blocks_unresolved(s)?) {
        return Result.Err("unresolved variables: ${names}");
    }
    if (p.oauth_blocked != "") {
        return Result.Err(p.oauth_blocked);
    }
    var prepared = match (exec.prepare(p.request)) {
        Result.Ok(prep) => prep,
        Result.Err(e) => return Result.Err(if (missing.len() > 0) { "${e} (unresolved variables: ${names})" } else { e }),
    };
    prepared.credentials = p.credentials;
    if (r.use_cookies && p.scope.environment_id != 0) {
        prepared.use_jar = true;
        prepared.jar = store.list_cookies(s, p.scope.environment_id)?;
    }
    Result.Ok(
        Job {
            run: run,
            request_id: r.id,
            prepared: prepared,
            environment_id: p.scope.environment_id,
            environment: p.scope.environment,
            captures: r.captures,
            assertions: vars.resolve_assertions(r.assertions, p.scope.vars),
            unresolved: missing,
            oauth: p.oauth,
            token: Option.None
        }
    )
}

fn dispatch(s: store.Store, req: json.Json, op: string) -> Result<Action, string> {
    let id = jsonv.get_int(req, "id");
    let reply = match (op) {
        "bootstrap" => bootstrap(s)?,
        "projects.list" => projects_json(s)?,
        "projects.create" => model.project_json(
            store.create_project_with(
                s,
                jsonv.get_str(req, "name"),
                jsonv.get_str(req, "description"),
                jsonv.get_str(req, "environment")
            )?
        ),
        "projects.update" => model.project_json(
            store.update_project(
                s,
                id,
                jsonv.get_str(req, "name"),
                jsonv.get_str(req, "description")
            )?
        ),
        "projects.delete" => jsonv.num(store.delete_project(s, id)?),
        "environments.list" => environments_json(s, jsonv.need_int(req, "project_id")?)?,
        "environments.create" => model.environment_json(
            store.create_environment(
                s,
                jsonv.need_int(req, "project_id")?,
                jsonv.get_str(req, "name"),
                jsonv.get_int(req, "copy_from")
            )?
        ),
        "environments.rename" => model.environment_json(store.rename_environment(s, id, jsonv.get_str(req, "name"))?),
        "environments.activate" => model.environment_json(store.activate_environment(s, id)?),
        "environments.delete" => jsonv.num(store.delete_environment(s, id)?),
        "environments.variables" => {
            store.get_environment(s, id)?;
            model.pairs_json(store.environment_variables(s, id)?)
        },
        "environments.save_variables" => model.pairs_json(store.save_environment_variables(s, id, model.pairs_of(req, "variables"))?),
        "variables" => variables(s, req)?,
        "curl.parse" => {
            let imported = curl.parse(jsonv.get_str(req, "text"))?;
            jsonv.obj(
                [
                    ("request", model.request_json(imported.request)),
                    ("warnings", jsonv.strs(imported.warnings))
                ]
            )
        },
        "openapi.import" => return Result.Ok(Action.ImportSpec(spec_job(s, req)?)),
        "oauth.status" => oauth_status(s, oauth_target(s, req)?)?,
        "oauth.token" => return Result.Ok(Action.OAuth(oauth_job(s, req)?)),
        "oauth.cancel" => return Result.Ok(Action.OAuthCancel(jsonv.need_int(req, "run")?)),
        "oauth.clear" => {
            let x = oauth_target(s, req)?;
            jsonv.num(store.delete_token(s, x.environment_id, x.owner)?)
        },
        "curl.export" => curl_export(s, model.request_of(jsonv.need_obj(req, "request")?)?)?,
        "cookies.list" => {
            store.get_environment(s, jsonv.need_int(req, "environment_id")?)?;
            cookies_json(store.list_cookies(s, jsonv.need_int(req, "environment_id")?)?)
        },
        "cookies.delete" => jsonv.num(
            store.delete_cookie(
                s,
                jsonv.need_int(req, "environment_id")?,
                jsonv.get_str(req, "name"),
                jsonv.get_str(req, "domain"),
                jsonv.get_str(req, "path")
            )?
        ),
        "cookies.clear" => jsonv.num(store.clear_cookies(s, jsonv.need_int(req, "environment_id")?)?),
        "tree" => tree_json(s, jsonv.need_int(req, "project_id")?)?,
        "runner.plan" => runner_plan(s, jsonv.need_int(req, "project_id")?, jsonv.get_int(req, "folder_id"))?,
        "folders.create" => model.folder_json(
            store.create_folder(
                s,
                jsonv.need_int(req, "project_id")?,
                jsonv.get_int(req, "parent_id"),
                jsonv.get_str(req, "name")
            )?
        ),
        "folders.rename" => model.folder_json(store.rename_folder(s, id, jsonv.get_str(req, "name"))?),
        "folders.move" => model.folder_json(store.move_folder(s, id, jsonv.get_int(req, "parent_id"))?),
        "folders.delete" => jsonv.num(store.delete_folder(s, id)?),
        "folders.auth" => model.auth_json(store.get_folder(s, id)?.auth),
        "folders.save_auth" => model.auth_json(
            store.save_folder_auth(s, id, model.auth_of(jsonv.need_obj(req, "auth")?)?)?.auth
        ),
        "folders.variables" => {
            store.get_folder(s, id)?;
            model.pairs_json(store.folder_variables(s, id, jsonv.get_int(req, "environment_id"))?)
        },
        "folders.save_variables" => model.pairs_json(
            store.save_folder_variables(
                s,
                id,
                jsonv.get_int(req, "environment_id"),
                model.pairs_of(req, "variables")
            )?
        ),
        "requests.create" => {
            var r = model.new_request(
                jsonv.need_int(req, "project_id")?,
                jsonv.get_int(req, "folder_id"),
                jsonv.get_str(req, "name")
            );
            // A request created from a draft (duplicate of an unsaved tab, cURL later) brings
            // its fields; a plain "New request" brings none.
            if let Option.Some(draft) = json.member(req, "request") {
                let d = model.request_of(draft)?;
                r.method = d.method;
                r.url = d.url;
                r.params = d.params;
                r.headers = d.headers;
                r.body_type = d.body_type;
                r.body = d.body;
                r.form = d.form;
                r.parts = d.parts;
                r.captures = d.captures;
                r.assertions = d.assertions;
                r.auth = d.auth;
                r.use_cookies = d.use_cookies;
                r.timeout_ms = d.timeout_ms;
                r.follow_redirects = d.follow_redirects;
                r.max_redirects = d.max_redirects;
            }
            model.request_json(store.create_request(s, r)?)
        },
        "requests.get" => model.request_json(store.get_request(s, id)?),
        "requests.save" => model.request_json(
            store.save_request(s, model.request_of(jsonv.need_obj(req, "request")?)?)?
        ),
        "requests.rename" => model.request_json(store.rename_request(s, id, jsonv.get_str(req, "name"))?),
        "requests.move" => model.request_json(store.move_request(s, id, jsonv.get_int(req, "folder_id"))?),
        "requests.duplicate" => model.request_json(store.duplicate_request(s, id)?),
        "requests.delete" => jsonv.num(store.delete_request(s, id)?),
        "send" => return Result.Ok(Action.Send(prepare_send(s, req)?)),
        "cancel" => return Result.Ok(Action.Cancel(jsonv.need_int(req, "run")?)),
        "history.list" => history_json(store.list_history(s, jsonv.need_int(req, "request_id")?)?),
        "history.get" => {
            let rec = store.history_record(s, id)?;
            view.present(view.outcome_of_record(rec)?, id)
        },
        "history.clear" => jsonv.num(store.clear_history(s, jsonv.need_int(req, "request_id")?)?),
        "body.save" => return Result.Ok(Action.SaveBody(jsonv.need_int(req, "history_id")?)),
        "settings.set" => {
            let key = jsonv.need_str(req, "key")?;
            if (!allowed_setting(key)) {
                return Result.Err("unknown setting '${key}'");
            }
            let v = jsonv.get_str(req, "value");
            store.set_setting(s, key, v)?;
            if (key == "language") {
                return Result.Ok(Action.Language(v));
            }
            jsonv.flag(true)
        },
        "clipboard.write" => return Result.Ok(Action.Clipboard(jsonv.get_str(req, "text"))),
        "url.open" => {
            let u = jsonv.need_str(req, "url")?;
            if (!u.starts_with("https://") && !u.starts_with("http://")) {
                return Result.Err("not a web URL: ${u}");
            }
            return Result.Ok(Action.OpenUrl(u));
        },
        "updates.check" => return Result.Ok(Action.CheckUpdate),
        "updates.install" => {
            return Result.Ok(
                Action.InstallUpdate(updates.from_json(jsonv.need_obj(req, "release")?)?)
            );
        },
        "log" => {
            eprint("rayreq: page: " + jsonv.get_str(req, "message"));
            jsonv.flag(true)
        },
        "appearance" => return Result.Ok(Action.Appearance(jsonv.need_str(req, "mode")?)),
        "quit" => return Result.Ok(Action.Quit),
        _ => return Result.Err("unknown op: ${op}"),
    };
    Result.Ok(Action.Reply(ok(reply)))
}

/// One request body from the page; never fails (an error is an `{ok: false}` reply).
pub fn handle(s: store.Store, body: string) -> Action {
    let req = match (json.parse(body)) {
        Result.Ok(j) => j,
        Result.Err(e) => return Action.Reply(fail("bad request: ${e}")),
    };
    let op = match (json.get_string(req, "op")) {
        Option.Some(op) => op,
        Option.None => return Action.Reply(fail("missing field 'op'")),
    };
    match (dispatch(s, req, op)) {
        Result.Ok(a) => a,
        Result.Err(e) => Action.Reply(fail(e)),
    }
}
