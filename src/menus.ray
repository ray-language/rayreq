//! The menu bar, in the page's language. Every item's tag goes to the page as is (the page
//! owns the tabs and the drafts); the command palette lists the same items through the bridge.

import std/ui;
import elements/bridge;

fn tr(lang: string, en: string, es: string) -> string {
    if (lang == "es") { es } else { en }
}

pub fn file_menu(lang: string) -> [ui.MenuItem] {
    [
        ui.item("new-request", tr(lang, "New Request", "Nueva petición"), "cmd+n"),
        ui.item("new-folder", tr(lang, "New Folder", "Nueva carpeta"), "cmd+shift+n"),
        ui.item("new-project", tr(lang, "New Project…", "Nuevo proyecto…"), ""),
        ui.item("import-curl", tr(lang, "Import cURL…", "Importar cURL…"), "cmd+shift+i"),
        ui.item("import-openapi", tr(lang, "Import OpenAPI…", "Importar OpenAPI…"), "cmd+shift+o"),
        ui.separator(),
        ui.item("save", tr(lang, "Save", "Guardar"), "cmd+s"),
        ui.item("close-tab", tr(lang, "Close Tab", "Cerrar pestaña"), "cmd+w")
    ]
}

pub fn request_menu(lang: string) -> [ui.MenuItem] {
    [
        ui.item("send", tr(lang, "Send", "Enviar"), "cmd+enter"),
        ui.item("duplicate", tr(lang, "Duplicate", "Duplicar"), "cmd+d"),
        ui.item("copy-curl", tr(lang, "Copy as cURL", "Copiar como cURL"), "cmd+shift+c"),
        ui.item("run-folder", tr(lang, "Run Folder…", "Ejecutar carpeta…"), "cmd+shift+r"),
        ui.separator(),
        ui.item("focus-url", tr(lang, "Go to URL", "Ir a la URL"), "cmd+l"),
        ui.separator(),
        ui.item("environments", tr(lang, "Manage Environments…", "Gestionar entornos…"), "cmd+e"),
        ui.item("cookies", tr(lang, "Cookies…", "Cookies…"), "")
    ]
}

pub fn view_menu(lang: string) -> [ui.MenuItem] {
    [
        ui.item("palette", tr(lang, "Command Palette…", "Paleta de comandos…"), "cmd+k"),
        ui.item(
            "toggle-sidebar",
            tr(lang, "Toggle Sidebar", "Mostrar u ocultar la barra lateral"),
            "cmd+b"
        )
    ]
}

fn edit_items() -> [ui.MenuItem] {
    [
        ui.item("role:undo", "", ""),
        ui.item("role:redo", "", ""),
        ui.separator(),
        ui.item("role:cut", "", ""),
        ui.item("role:copy", "", ""),
        ui.item("role:paste", "", ""),
        ui.separator(),
        ui.item("role:select_all", "", "")
    ]
}

/// The About and Check for Updates items, in the application menu. Its tag is "about", not "role:about": the item
/// reaches the page on every platform and opens the app's own About window (the page's dialog,
/// with the icon, the version and the copyright), the same on macOS, Linux and Windows. The
/// system's panel is still described (`describe`), for whatever else opens it. Before the first
/// window.
pub fn install_about(name: string, version: string, lang: string) -> Result<int, string> {
    ui.app_menu(
        name,
        [
            ui.item("about", tr(lang, "About ${name}", "Acerca de ${name}"), ""),
            ui.item("check-updates", tr(lang, "Check for Updates…", "Buscar actualizaciones…"), "")
        ]
    )?;
    describe(name, version, lang)
}

/// What the system's About panel would say, in the page's language. No description: the panel
/// shows it in another font (findings #305), so "made with raylang" goes on the copyright line.
pub fn describe(name: string, version: string, lang: string) -> Result<int, string> {
    ui.set_about(name, version, "", tr(lang, COPYRIGHT_EN, COPYRIGHT_ES))
}

pub const COPYRIGHT_EN: string = "© 2026 Rayala · Made with raylang";

pub const COPYRIGHT_ES: string = "© 2026 Rayala · Hecho con raylang";

pub struct Titles {
    file: string,
    request: string,
    view: string,
}

pub fn titles(lang: string) -> Titles {
    Titles {
        file: tr(lang, "File", "Archivo"),
        request: tr(lang, "Request", "Petición"),
        view: tr(lang, "View", "Ver")
    }
}

/// Declares the bar (before the first window: on Linux a menu only reaches windows opened
/// after it).
pub fn install(n: bridge.Native, lang: string) -> Result<int, string> {
    let t = titles(lang);
    bridge.menu(n, t.file, file_menu(lang))?;
    ui.edit_menu(edit_items())?;
    bridge.menu(n, t.request, request_menu(lang))?;
    bridge.menu(n, t.view, view_menu(lang))
}

/// `bridge.rename_menu`, skipping a title that does not change.
fn rename(n: bridge.Native, old: string, new: string) -> Result<int, string> {
    if (old == new) {
        return Result.Ok(0);
    }
    bridge.rename_menu(n, old, new)
}

/// The bar, declared in `from`, switched to `to`: titles and items.
pub fn relabel(n: bridge.Native, from: string, to: string) -> Result<int, string> {
    let a = titles(from);
    let b = titles(to);
    rename(n, a.file, b.file)?;
    rename(n, a.request, b.request)?;
    rename(n, a.view, b.view)?;
    bridge.replace_menu(n, b.file, file_menu(to))?;
    bridge.replace_menu(n, b.request, request_menu(to))?;
    bridge.replace_menu(n, b.view, view_menu(to))
}
